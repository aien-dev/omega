+# HD-13: the quiet flag is a real lock (omega tools/quietlock). Every flag removal goes through
+# quietlock under its flock; this script never rm's the flag itself. The forge never takes a hold:
+# before each job it waits until quietlock says clear. Jobs that need quiet raise their own hold.
+QL="${QUIETLOCK_BIN:-$(command -v quietlock 2>/dev/null || echo "$HOME/.local/bin/quietlock")}"
+REQUEUE_MAX="${REQUEUE_MAX:-3}"          # REFUSED_QUIET requeues per job before giving up
+FORGE_WAIT_SECONDS="${FORGE_WAIT_SECONDS:-}"  # seconds between looks at a held flag (default 60 main, 30 light)
+ql_ok() { [ -x "$QL" ] || { echo "quietlock not installed at $QL; see omega tools/quietlock/install.sh" >&2; return 1; }; }
+ql_wait_clear() { # $1 = seconds between looks; stale flags are released through quietlock only
+  while ! "$QL" check >/dev/null 2>&1; do "$QL" release-stale >/dev/null 2>&1; sleep "$1"; done
+}
+# REFUSED_QUIET only when the job exited 75 AND the log's final line is quietlock's own refusal.
+# A suite that merely prints the marker word somewhere is judged by its exit code like any other.
+ql_verdict() { # $1 = rc, $2 = log
+  if [ "$1" -eq 0 ]; then echo PASS
+  elif [ "$1" -eq 75 ] && tail -n 1 "$2" 2>/dev/null | grep -q '^quietlock: QUIETLOCK_REFUSED '; then echo REFUSED_QUIET
+  else echo "FAIL(rc=$1)"; fi
+}
+# Run one queued job ($1 lane, $2 dir, $3 cmd, $4 queue file for requeue, $5 log suffix); prints the verdict.
+# The lane may carry a requeue count as LANE@rN.
+ql_job() {
+  base=${1%@r*}; n=0; case $1 in *@r[0-9]*) n=${1##*@r};; esac
+  log="$LOGDIR/$base$5-$(date -u +%H%M%S).log"
+  echo "[$(iso)] $base: $3"
+  ( cd "$2" && "$QL" run -- bash -c "$3" ) >"$log" 2>&1 < /dev/null; rc=$?
+  v=$(ql_verdict "$rc" "$log")
+  # queen 2026-10-01: a zero exit that skipped work is not a PASS (TR-02 18:15Z looked green with all QEMU legs skipped)
+  [ $rc -eq 0 ] && grep -qE "NOT_RUN|NOT_ALL_GATES_PASS|quiet flag .* is held|SKIPPED: quiet" "$log" && v="SUSPECT(rc=0 but NOT_RUN/skip seen in log)"
+  if [ "$v" = REFUSED_QUIET ]; then
+    if [ "$n" -ge "$REQUEUE_MAX" ]; then v=REFUSED_QUIET_GAVE_UP
+    else echo "$base@r$((n + 1))|$2|$3" >> "$4.requeue"; fi
+  fi
+  echo "- $base: $v  cmd: \`$3\`  log: $log" >> "$RESULTS"; echo "   -> $v"
+}
 TASKDIR="${LANES_TASKDIR:-$(ls -dt /tmp/claude-1000/-home-drakestapleton/*/tasks 2>/dev/null | head -1)}"
 
