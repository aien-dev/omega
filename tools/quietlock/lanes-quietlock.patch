+# HD-13: the quiet flag is a real lock (omega tools/quietlock). Every flag removal and every
+# job goes through quietlock under its flock; this script never rm's the flag itself.
+QL="${QUIETLOCK_BIN:-$(command -v quietlock 2>/dev/null || echo "$HOME/.local/bin/quietlock")}"
+FORGE_HOLD_MIN="${FORGE_HOLD_MIN:-20}"   # >20 needs Drake's approval token (.spark-quiet-approval, owner=forge)
+ql_ok() { [ -x "$QL" ] || { echo "quietlock not installed at $QL; run omega tools/quietlock/install.sh" >&2; return 1; }; }
+# wait until quietlock says clear (stale flags are released through quietlock only)
+ql_wait_clear() { # $1 = seconds between looks
+  while ! "$QL" check >/dev/null 2>&1; do "$QL" release-stale >/dev/null 2>&1; sleep "$1"; done
+}
+# verdict for one job: exit 75 or the QUIETLOCK_REFUSED marker in its log = REFUSED_QUIET (requeued, never FAIL)
+ql_verdict() { # $1 = rc, $2 = log
+  if [ "$1" -eq 0 ]; then echo PASS
+  elif [ "$1" -eq 75 ] || grep -q QUIETLOCK_REFUSED "$2" 2>/dev/null; then echo REFUSED_QUIET
+  else echo "FAIL(rc=$1)"; fi
+}
