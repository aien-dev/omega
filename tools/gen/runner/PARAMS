# GEN runner parameters (omega#477, GEN-2). DRAFT: the values marked PLACEHOLDER wait for GEN_PROTOCOL_V1
# (Agent A, #476), the corpus record set (Agent D, #478) and the genret binary (Agent E, #479). run.sh refuses
# a non-test run while any value is PLACEHOLDER or revision is a draft. GEN_PARAMS names another file, for
# tests only (GEN_TEST=1). Paths are relative to the repository root.
revision=gen-v1-draft
protocol=PLACEHOLDER docs/one_layer/GEN_PROTOCOL_V1.md
# protocol.json (omega.gen.protocol.v1, gen/protocol 7eb8534c): run.sh checks every setting below against it
protocol_json=PLACEHOLDER tests/one_layer/generalization/protocol.json
protocol_json_sha256=a28142baeeb3d7218ddd3baea6bcaf2ae48de5e6eb1975a38845c008737ee0b8
# model pin: configuration <config> of the EXP445 PARAMS (model id, endpoint, request extra, server, weights)
exp445_params=tools/exp445/PARAMS
config=A
mask=off
conditions=A,B,C,D
attempts=3
max_tokens=3072
# attempt 1 is greedy (primary); attempts 2..attempts are sampled, only after a G0 PASS
greedy_temperature=0
greedy_top_p=1
temperature=0.7
top_p=0.8
seed_base=476000
timeout_s=900
retries=2
# prompt prefix: worked examples in the tools/exp445/arms/examples layout; A uses examples_one, B C D examples_many
examples_dir=PLACEHOLDER tools/exp445/arms/examples
examples_one=one.list
examples_many=many.list
# retrieval: provider_contract only (tools/gen/retrieval/CONTRACT.md; protocol.json retrieval.contract), C = --kind raw
# over the raw record set, D = --kind abstraction over the abstraction record set (protocol.json record_sets.*);
# each manifest = a records/MANIFEST, its sha256 = the content of that set's SET.sha256; recheck = D's validator as
# built by make gen-retrieval, which writes its sha256 to recheck_sha256_file (passed as --recheck-sha256)
provider=PLACEHOLDER build/gen_retrieval/genret
provider_contract=genret-cli-v3
provider_contract_sha256=48006271d18394c40daf96120eaa20fbe3908d9a12b08cab7994ee02a6351e9d
corpus_manifest_raw=PLACEHOLDER tests/one_layer/generalization/corpus/raw/records/MANIFEST
corpus_manifest_raw_sha256=PLACEHOLDER
corpus_manifest_abstraction=PLACEHOLDER tests/one_layer/generalization/corpus/abstraction/records/MANIFEST
corpus_manifest_abstraction_sha256=PLACEHOLDER
recheck=PLACEHOLDER build/gen_retrieval/recheck
recheck_sha256_file=PLACEHOLDER build/gen_retrieval/recheck.sha256
# the recheck.c genret was built from (mk/gen-retrieval.mk GENRET_RECHECK_SHA256, gen/retrieval 4a48b613); every
# provider receipt must name it (genret_anyrecheck test builds say "unverified" and are refused)
recheck_source_sha256=05cec285f7b7b2be68b1db1287661513e7e4715da44909065bdd0829daac02b6
retrieval_mode=normal
k=3
cap_bytes=4096
# k, cap_bytes, retrieval_mode: preregistered by Agent A (relay 2026-10-15; GEN_PROTOCOL_V1 and protocol.json
# pending). Cross-family negative control (run.sh --control cross-family): DEV tasks only, each C/D query
# gets --exclude-family <famsig token of that dev task's own shape> (dev_meta, famsig: FAMSIG_V1.md)
famsig=PLACEHOLDER build/gen/famsig
dev_meta=PLACEHOLDER tests/one_layer/generalization/dev/META
# gates: public dev tasks (tasks/cases/<id>/{requirement,prompt}); greedy gate = the first greedy_gate_tasks
# dev tasks in condition B sent twice at temperature 0; G0 = g0_task in condition B at g0_seeds seeds + 1 repeat
dev_tasks=PLACEHOLDER tests/one_layer/generalization/dev
greedy_gate_tasks=10
g0_task=devgen01
g0_seeds=8
