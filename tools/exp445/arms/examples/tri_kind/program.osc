fn tri_kind(a: u16, b: u16, c: u16) -> u8 {
    let x: u32 = a as u32;
    let y: u32 = b as u32;
    let z: u32 = c as u32;
    if x + y <= z || x + z <= y || y + z <= x {
        return 0;
    } else if a == b && b == c {
        return 1;
    } else if a == b || b == c || a == c {
        return 2;
    }
    return 3;
}
