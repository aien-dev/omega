OMEGA-AT1-CASE v1
domain omega.at1.case.v1
contract AT1_CASE_V1
case_name a7h-11-n4b-broken-clock
begin semantic
model_family PAGE_WOOTTERS_FINITE_CLOCKDIAG
energy_unit DIMENSIONLESS_HBAR_1
clock_dim 3
clock_energies -4/5,-3/10,37/10
system_dim 2
system_hamiltonian_pauli -9/20,9/13,9/52,3/13
interaction CLOCK_DIAGONAL_PAULI
interaction_pauli 0 -211/117,179/468,-173/468
interaction_pauli 1 0/1,0/1,0/1
interaction_pauli 2 0/1,0/1,0/1
constraint SUM_HC_HS_V
physical_state NULLSPACE_PROJECTION
reference_clock_label t3
reference_system_state (1/1;0/1),(0/1;1/1)
clock_povm COVARIANT_DISCRETE
povm_tau_turns 1/2
povm_weight 3/4
clock_label_count 4
clock_label 0 t0
clock_label 1 t1
clock_label 2 t2
clock_label 3 t3
observables PAULI_X,PAULI_Y,PAULI_Z
end semantic
begin acceptance
control_kind NEGATIVE
prediction_target INTERACTING
expected_outcome FAIL
expected_failure_codes POVM_NORMALIZATION_EXCEEDED
min_bound_kind ESTIMATED
tol_constraint_residual 1@12
tol_povm_residual 1@12
tol_probability 1@12
tol_zero_probability 1@9
tol_schrodinger 1@12
end acceptance
case_id bebaa09ab9bca58589861a1cadaca6cd67cad7ec84429f4fa5d022fed7264513
acceptance_id c5a9db246c5b7f5d2101fea27c238fdba65a58aded6ef3c15ee301a6e3624e4c
end
