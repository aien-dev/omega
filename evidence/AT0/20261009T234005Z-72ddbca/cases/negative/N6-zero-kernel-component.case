OMEGA-AT0-CASE v1
domain omega.at0.case.v1
contract AT0_CASE_V1
case_name at0-n6-zero-kernel-component
begin semantic
model_family PAGE_WOOTTERS_FINITE_IDEAL
energy_unit DIMENSIONLESS_HBAR_1
clock_dim 4
clock_energies -3/2,1/2,3/2,7/2
system_dim 2
system_hamiltonian_pauli 0/1,0/1,0/1,1/2
interaction NONE
constraint SUM_HC_HS
physical_state NULLSPACE_PROJECTION
reference_clock_label t0
reference_system_state (1/1;0/1),(0/1;0/1)
clock_povm COVARIANT_DISCRETE
povm_tau_turns 1/4
povm_weight 1/1
clock_label_count 4
clock_label 0 t0
clock_label 1 t1
clock_label 2 t2
clock_label 3 t3
observables PAULI_X,PAULI_Y,PAULI_Z
end semantic
begin acceptance
control_kind NEGATIVE
expected_outcome FAIL
expected_failure_codes TRIVIAL_PHYSICAL_STATE
min_bound_kind ESTIMATED
tol_constraint_residual 1@12
tol_povm_residual 1@12
tol_probability 1@12
tol_zero_probability 1@9
tol_schrodinger 1@12
end acceptance
case_id f5cea11fcc39d5afca6c01079b14cbd8edacd4ea2b22e20c85b65d17d8d678ca
acceptance_id b9cbcd95b3c4ae102a33cc055aaaf18f2c9bf67144e2b2c34c3d9a381cd1ac97
end
