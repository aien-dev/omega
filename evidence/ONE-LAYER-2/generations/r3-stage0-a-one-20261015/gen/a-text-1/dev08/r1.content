```
fn collatz_steps(n: u32) -> u32 {
    let mut steps: u32 = 0;
    let mut current: u32 = n;
    while current != 1 {
        if current % 2 == 0 {
            current = current / 2;
        } else {
            current = 3 * current + 1;
        }
        steps = steps + 1;
    }
    return steps;
}
