{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "turing.cal.measurement_receipt.v1",
  "title": "Turing-profile-v1.0 measurement receipt",
  "description": "One receipt per scored run (final, void or independent scorer). Integers are exact: ub = micro-bits (1 bit = 1000000 ub). No sealed data bytes appear in a receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment", "kind", "verdict", "created_utc", "profile", "freeze", "runtime_sha256", "sealed", "groups", "criteria", "refusals", "deviations"],
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ub": {"type": "integer"},
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["point_ub", "lo_ub", "hi_ub"],
      "properties": {"point_ub": {"$ref": "#/definitions/ub"}, "lo_ub": {"$ref": "#/definitions/ub"}, "hi_ub": {"$ref": "#/definitions/ub"}}
    },
    "coded": {
      "type": "object", "additionalProperties": false,
      "required": ["coder", "coded_bytes", "coded_bits", "decoded_ok", "overhead_ub", "inside_envelope"],
      "properties": {
        "coder": {"type": "string"},
        "coded_bytes": {"type": "integer", "minimum": 0},
        "coded_bits": {"type": "integer", "minimum": 0},
        "coded_sha256": {"$ref": "#/definitions/sha256"},
        "decoded_ok": {"type": "boolean"},
        "overhead_ub": {"$ref": "#/definitions/ub"},
        "inside_envelope": {"type": "boolean"},
        "t_vs_b2": {"$ref": "#/definitions/interval"}
      }
    },
    "candidate_result": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "model_digest", "lm_bits", "ld_ideal_ub", "per_crumb_sum_equals_file", "t_vs_b2_ideal", "coded"],
      "properties": {
        "name": {"type": "string"},
        "model_digest": {"$ref": "#/definitions/sha256"},
        "lm_bits": {"type": "integer", "minimum": 0},
        "ld_ideal_ub": {"$ref": "#/definitions/ub"},
        "per_crumb_sum_equals_file": {"type": "boolean"},
        "t_vs_b2_ideal": {"$ref": "#/definitions/interval"},
        "t_vs_other_baselines": {"type": "object", "additionalProperties": {"$ref": "#/definitions/interval"}},
        "coded": {"type": "array", "items": {"$ref": "#/definitions/coded"}}
      }
    }
  },
  "properties": {
    "schema": {"const": "turing.cal.measurement_receipt.v1"},
    "experiment": {"type": "string"},
    "kind": {"enum": ["final", "void", "independent"]},
    "verdict": {"enum": ["PASS", "FAIL", "VOID"]},
    "created_utc": {"type": "string"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "sidecar_matches"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/definitions/sha256"}, "sidecar_matches": {"type": "boolean"}}
    },
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "candidate_manifest_sha256", "preregistration_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_manifest_sha256": {"$ref": "#/definitions/sha256"},
        "preregistration_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "runtime_sha256": {"type": "object", "additionalProperties": {"$ref": "#/definitions/sha256"}},
    "sealed": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "complete_utc", "overlap_audit_pass"],
      "properties": {
        "manifest_sha256": {"$ref": "#/definitions/sha256"},
        "complete_utc": {"type": "string"},
        "overlap_audit_pass": {"type": "boolean"}
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["g", "seeds", "stream_sha256", "crumbs", "events", "bootstrap_seed", "resamples", "candidates"],
        "properties": {
          "g": {"enum": [1, 2]},
          "seeds": {"type": "array", "items": {"type": "integer"}},
          "stream_sha256": {"type": "array", "items": {"$ref": "#/definitions/sha256"}},
          "crumbs": {"type": "integer", "minimum": 1},
          "events": {"type": "integer", "minimum": 1},
          "bootstrap_seed": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{16}$"},
          "resamples": {"const": 10000},
          "candidates": {"type": "array", "items": {"$ref": "#/definitions/candidate_result"}}
        }
      }
    },
    "criteria": {
      "type": "object", "additionalProperties": false,
      "required": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9"],
      "patternProperties": {"^S[1-9]$": {"enum": ["PASS", "FAIL", "NOT_REACHED"]}}
    },
    "refusals": {"type": "array", "items": {"type": "object", "required": ["step", "code", "reason"], "properties": {"step": {"type": "string"}, "code": {"type": "string"}, "reason": {"type": "string"}}}},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "void_attempts_cited": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
