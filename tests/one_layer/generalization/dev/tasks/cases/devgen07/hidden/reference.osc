fn max_rise4(a: i32, b: i32, c: i32, d: i32) -> i64 {
    let v: own [i64; 4] = alloc(0);
    v[0] = a as i64;
    v[1] = b as i64;
    v[2] = c as i64;
    v[3] = d as i64;
    let mut best: i64 = v[1] - v[0];
    for i in 1 .. 3 {
        let r: i64 = v[i + 1] - v[i];
        if r > best { best = r; }
    }
    return best;
}
