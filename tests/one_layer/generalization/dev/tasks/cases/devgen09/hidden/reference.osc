fn pair_sum_div(n: u8, k: u8) -> u32 {
    let m: u32 = n as u32;
    let q: u32 = k as u32;
    let mut c: u32 = 0;
    let mut i: u32 = 1;
    while i <= m bound 256 {
        let mut j: u32 = i + 1;
        while j <= m bound 256 {
            if (i + j) % q == 0 { c = c + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return c;
}
