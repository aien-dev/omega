fn spread4(a: u32, b: u32, c: u32, d: u32) -> u64 {
    let v: own [u32; 4] = alloc(0);
    v[0] = a;
    v[1] = b;
    v[2] = c;
    v[3] = d;
    let mut s4: u64 = 0;
    let mut m4: u32 = v[0];
    for i in 0 .. 4 { s4 = s4 + (v[i] as u64); if v[i] > m4 { m4 = v[i]; } }
    return (m4 as u64) * 4 - s4;
}
