fn clamp(x: u32, lo: u32, hi: u32) -> u32 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}
fn absdiff(a: u32, b: u32) -> u32 {
    if a > b { return a - b; }
    return b - a;
}
fn clamp_gap(a: u32, b: u32, lo: u32, hi: u32) -> u32 {
    return clamp(absdiff(a, b), lo, hi);
}
