fn gcd(a: u32, b: u32) -> u32 {
    let mut x: u32 = a;
    let mut y: u32 = b;
    while y != 0 bound 100 { let t: u32 = x % y; x = y; y = t; }
    return x;
}
fn digsum(n: u32) -> u32 {
    let mut x: u32 = n;
    let mut s: u32 = 0;
    while x > 0 bound 20 { s = s + x % 10; x = x / 10; }
    return s;
}
fn gcd_plus_ds(a: u32, b: u32) -> u32 {
    return gcd(a, b) + digsum(a);
}
