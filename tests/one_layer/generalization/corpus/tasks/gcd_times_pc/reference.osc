fn gcd(a: u32, b: u32) -> u32 {
    let mut x: u32 = a;
    let mut y: u32 = b;
    while y != 0 bound 100 { let t: u32 = x % y; x = y; y = t; }
    return x;
}
fn popcnt(x: u32) -> u32 {
    let mut c: u32 = 0;
    for i in 0 .. 32 { c = c + ((x >> i) & 1); }
    return c;
}
fn gcd_times_pc(a: u32, b: u32) -> u32 {
    return gcd(a, b) * popcnt(b);
}
