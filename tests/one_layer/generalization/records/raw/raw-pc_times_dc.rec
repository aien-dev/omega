body
fn popcnt x uint to uint
c = uint 0
for i uint 32
c = add c and shr x i 1
end
ret c
end
fn digcount n uint to uint
c = uint 1
while ge n 10 bound 20
c = add c 1
n = div n 10
end
ret c
end
fn pc_times_dc x uint to uint
ret mul popcnt x digcount x
end
