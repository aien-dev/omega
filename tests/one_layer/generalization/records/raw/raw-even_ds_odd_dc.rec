body
fn digsum n uint to uint
s = uint 0
while gt n 0 bound 20
s = add s rem n 10
n = div n 10
end
ret s
end
fn digcount n uint to uint
c = uint 1
while ge n 10 bound 20
c = add c 1
n = div n 10
end
ret c
end
fn even_ds_odd_dc n uint to uint
if eq rem n 2 0
ret digsum n
end
ret digcount n
end
