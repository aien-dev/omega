body
fn gcd a uint b uint to uint
while ne b 0 bound 100
t = rem a b
a = b
b = t
end
ret a
end
fn digsum n uint to uint
s = uint 0
while gt n 0 bound 20
s = add s rem n 10
n = div n 10
end
ret s
end
fn gcd_plus_ds a uint b uint to uint
ret add gcd a b digsum a
end
