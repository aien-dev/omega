# tests/gates/omega-r12-silicon.gate
# Mirrors hosted: rx-host.yml chip-only-declared: test-r12-silicon is declared SKIP on GitHub (needs the GB10 resident seat); qualified only by a candidate-bound Spark receipt
gate: OMEGA-R12-SILICON
manifest_version: 2
owner: omega
requires:
  - gb10
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - aienos.lock
  - argus.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["chip:test-r12-silicon"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: hardware
cache: never
