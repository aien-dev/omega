// slice-entry: total scan_and_mark
// A slice goes down whole (pointer and length: two registers) to a callee's slice parameter of the same type.
// slice-run: total bytes:01020304 -> 10
// slice-run: total bytes: -> 0
// slice-run: scan_and_mark bytes:00ff00ff cells:4 -> 2 cells=0,1,0,1
// slice-run: scan_and_mark bytes:00ff00ff cells:3 -> 2 cells=0,1,0
// slice-run: scan_and_mark bytes:0100 cells:NULL -> 1
fn add_at(b: bytes, i: u64) -> u64 {
    return b[i];
}

fn total(b: bytes) -> u64 {
    let mut s: u64 = 0;
    let mut i: u64 = 0;
    while i < b.len bound 4096 {
        s = s + add_at(b, i);
        i = i + 1;
    }
    return s;
}

fn mark(c: cells, i: u64, v: u64) {
    c[i] = v;
}

fn nonzero(b: bytes, i: u64) -> u64 {
    if b[i] != 0 {
        return 1;
    }
    return 0;
}

// counts the non-zero bytes and marks them in c when c has room (two slices, one scalar, six registers)
fn scan_and_mark(b: bytes, c: cells) -> u64 {
    let mut n: u64 = 0;
    let mut i: u64 = 0;
    while i < b.len bound 4096 {
        let z: u64 = nonzero(b, i);
        n = n + z;
        if i < c.len {
            mark(c, i, z);
        }
        i = i + 1;
    }
    return n;
}
