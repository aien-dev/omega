// entry: collatz
// expect-run: collatz 27 -> 111
// expect-run: collatz 1 -> 0
// expect-run: collatz 0 -> trap=LOOP_BOUND
// Collatz steps with a static bound: very long or endless orbits trap LOOP_BOUND.
fn collatz(n0: u32) -> u32 {
    let mut n: u64 = n0 as u64;
    let mut steps: u32 = 0;
    while n != 1 bound 300 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        steps = steps + 1;
    }
    return steps;
}
