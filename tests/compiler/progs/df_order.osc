// entry: order
// OSC-3 item 3 (drop flags): release order with conditional moves, asserted
// by test_osc_compiler for k = 0, 1, 3 in the interpreter and natively:
//   k=0: alloc 1 2 3, release 2 (q), alloc 4 5, release 5 4 3 1 (p skipped)
//   k=1: alloc 1 2 3, release 1 (eata), alloc 4 5, release 5 4 3 2 (a skipped)
//   k=3: alloc 1 2 3, release 1, alloc 4, release 4 (eata), alloc 5, release 5 3 2
struct P { x: u32, y: u32 }

fn eata(a: own [u32; 2]) -> u32 { return a[0] + a[1]; }

fn order(k: u32) -> u32 {
    let a: own [u32; 2] = alloc(k);
    let p: own P = P { x: k, y: 2 };
    let b: own [u32; 2] = alloc(5);
    let mut r: u32 = 0;
    if k > 0 { r = eata(a); } else { let q: own P = p; r = q.x + q.y; }
    let c: own [u32; 2] = alloc(7);
    if k > 1 { if k > 2 { r = r + eata(c); } }
    let d: own [u32; 2] = alloc(1);
    return r + b[0] + d[0];
}
// expect-run: order 0 -> 8
// expect-run: order 1 -> 8
// expect-run: order 3 -> 26
