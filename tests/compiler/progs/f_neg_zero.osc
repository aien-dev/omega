// entry: neg zero_minus neg_lit eq_zero div_nz abs_nz sqrt_nz sign_bit from_bits lit_bits sub_mul
// OSC-4 Slice A: the sign of zero. `-x` is FNEG (gives -0.0 from +0.0);
// `0.0 - x` is FSUB (gives +0.0). -0.0 == +0.0 is true; only `bits` sees the
// sign. 1.0 / -0.0 is -inf with no trap. sqrt(-0.0) is -0.0 (IEEE).
// expect-run: neg 0 -> 0x80000000
// expect-run: neg 0x80000000 -> 0
// expect-run: neg 0x3f800000 -> 0xbf800000
// expect-run: zero_minus 0 -> 0
// expect-run: zero_minus 0x80000000 -> 0
// expect-run: neg_lit 0 -> 0x80000000
// expect-run: neg_lit 1 -> 0xbfc00000
// expect-run: eq_zero 0x80000000 -> 1
// expect-run: eq_zero 0 -> 1
// expect-run: eq_zero 0x3f800000 -> 0
// expect-run: div_nz 0x3f800000 -> 0xff800000
// expect-run: div_nz 0xbf800000 -> 0x7f800000
// expect-run: abs_nz 0x80000000 -> 0
// expect-run: sqrt_nz 0x80000000 -> 0x80000000
// expect-run: sign_bit 0x80000000 -> 1
// expect-run: sign_bit 0 -> 0
// expect-run: from_bits 2147483648 -> 0x80000000
// expect-run: from_bits 1065353216 -> 0x3f800000
// expect-run: lit_bits 0 -> 0x80000000
// expect-run: lit_bits 1 -> 0x8000000000000000
// expect-run: sub_mul 0 -> 0
// expect-run: sub_mul 1 -> 0x8000000000000000
fn neg(x: f32) -> f32 { return -x; }
fn zero_minus(x: f32) -> f32 { return 0.0 - x; }
fn neg_lit(k: u8) -> f32 {
    if k == 0 { return -0.0; }
    return -1.5;
}
fn eq_zero(x: f32) -> bool { return x == 0.0; }
fn div_nz(x: f32) -> f32 {
    let nz: f32 = -0.0;
    return x / nz;
}
fn abs_nz(x: f32) -> f32 { return abs(x); }
fn sqrt_nz(x: f32) -> f32 { return sqrt(x); }
fn sign_bit(x: f32) -> u32 { return (x as u32 bits) >> 31; }
fn from_bits(u: u32) -> f32 { return u as f32 bits; }
fn lit_bits(k: u8) -> u64 {
    if k == 0 {
        let z: f32 = -0.0;
        return (z as u32 bits) as u64;
    }
    let d: f64 = -0.0;
    return d as u64 bits;
}
// -0.0 + 0.0 is +0.0 and -0.0 * 1.0 is -0.0 (both RNE, both FADD/FMUL)
fn sub_mul(k: u8) -> u64 {
    let nz: f64 = -0.0;
    if k == 0 { return (nz + 0.0) as u64 bits; }
    return (nz * 1.0) as u64 bits;
}
