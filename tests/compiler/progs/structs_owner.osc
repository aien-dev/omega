// entry: moves borrow_calls
// OSC-2 structs: moves (let and own parameters), shared and mutable borrows,
// passing structs to functions as own, & and &mut parameters.
struct Acc { sum: i64, hits: [u32; 3] }

fn total(a: &Acc) -> i64 {
    return a.sum + (a.hits[0] as i64) + (a.hits[1] as i64) + (a.hits[2] as i64);
}

fn add(a: &mut Acc, k: i64, slot: u8) {
    a.sum = a.sum + k;
    a.hits[slot] = a.hits[slot] + 1;
}

fn consume(a: own Acc) -> i64 {
    return total(&a) * 2;
}

fn moves(k: i32) -> i64 {
    let a: own Acc = Acc { sum: k as i64, hits: [0; 3] };
    let b: own Acc = a;
    b.hits[2] = 5;
    let c: own Acc = b;
    return consume(c) + 1;
}

fn borrow_calls(k: i16, slot: u8) -> i64 {
    let a: own Acc = Acc { hits: [1; 3], sum: 0 };
    add(&mut a, k as i64, slot);
    {
        let m: &mut Acc = &mut a;
        add(&mut m, 1, 0);
        m.sum = m.sum * 2;
    }
    let r: &Acc = &a;
    let t: i64 = total(&r);
    return t + (r.hits[0] as i64);
}
// expect-run: moves 10 -> 31
// expect-run: borrow_calls 3 1 -> 15
// expect-run: borrow_calls 3 3 -> trap=BOUNDS
