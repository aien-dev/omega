// entry: pop64 pop8 pop_kernighan
// expect-run: pop64 255 -> 8
// expect-run: pop64 18446744073709551615 -> 64
// expect-run: pop8 255 -> 8
// expect-run: pop_kernighan 4294967295 -> 32
// population count three ways.
fn pop64(x: u64) -> u32 {
    let mut n: u32 = 0;
    for i in 0 .. 64 {
        if (x >> (i as u64)) & 1 == 1 { n = n + 1; }
    }
    return n;
}

fn pop8(x: u8) -> u8 {
    let mut v: u8 = x;
    v = (v & 0x55) + ((v >> 1) & 0x55);
    v = (v & 0x33) + ((v >> 2) & 0x33);
    v = (v & 0x0f) + ((v >> 4) & 0x0f);
    return v;
}

fn pop_kernighan(x: u32) -> u32 {
    let mut v: u32 = x;
    let mut n: u32 = 0;
    while v != 0 bound 32 {
        v = v & (v - 1);
        n = n + 1;
    }
    return n;
}
