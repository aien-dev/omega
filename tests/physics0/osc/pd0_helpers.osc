// entry: mul const_draw noise_map l0_s0 l0_s1 l1_s0 l1_s1 l2_s1 cube description_bits
// PD-0 integer helpers written in the Omega Systems Core language (OSC-3
// subset: integer scalars, no structs, no I/O). Each function recomputes a
// piece of spec PD0_HIDDEN_EQUATION_BENCHMARK.md (physics main 2f881b1):
//   mul            section 2.1 product rescale (truncating toward zero)
//   const_draw     section 3 constant draw lo + ((hi - lo) * u) / 1e6
//   noise_map      section 3 Irwin-Hall map from four uniforms to the noise
//   l0_s0, l0_s1   section 4.1 L0 kinematics one tick
//   l1_s0, l1_s1   section 4.1 L1 spring one tick
//   l2_s1          section 4.1 L2 damped spring velocity tick
//   cube           the L4 monomial s0*s0*s0 in micro-units
//   description_bits  section 6.2 rule for one relation
// Limits: OSC has no 128-bit integer, so `mul` traps OVERFLOW instead of
// rescaling when |a*b| >= 2^63; the C side (pd0_mul) uses 128-bit. The
// differential test in tests/physics0/test_pd0_osc.c only feeds values inside
// the world box (|v| <= 10.0 units, constants <= 9.0), where both agree.
// expect-run: mul 2000000 3000000 -> 6000000
// expect-run: l0_s0 1500000 -500000 -> 1000000
// expect-run: description_bits 2 1 3 0 -> 144

fn mul(a: i64, b: i64) -> i64 {
    return (a * b) / 1000000;
}

fn const_draw(lo: i64, hi: i64, u: i64) -> i64 {
    return lo + ((hi - lo) * u) / 1000000;
}

fn noise_map(u1: i64, u2: i64, u3: i64, u4: i64, sigma: i64) -> i64 {
    let s: i64 = (u1 + u2 + u3 + u4) - 2000000;
    return (s * sigma) / 577350;
}

fn l0_s0(s0: i64, s1: i64) -> i64 {
    return s0 + s1;
}

fn l0_s1(s1: i64, u: i64) -> i64 {
    return s1 + u;
}

fn l1_s0(s0: i64, s1: i64, dt: i64) -> i64 {
    return s0 + mul(s1, dt);
}

fn l1_s1(s0: i64, s1: i64, u: i64, k: i64, dt: i64) -> i64 {
    let spring: i64 = 0 - mul(k, s0);
    return s1 + mul(spring + u, dt);
}

fn l2_s1(s0: i64, s1: i64, u: i64, k: i64, c: i64, dt: i64) -> i64 {
    let f: i64 = (0 - mul(k, s0)) - mul(c, s1) + u;
    return s1 + mul(f, dt);
}

fn cube(s0: i64) -> i64 {
    return mul(mul(s0, s0), s0);
}

fn description_bits(n_vars: u32, n_channels: u32, n_terms: u32, n_latent: u32) -> u32 {
    return n_terms * (8 * (n_vars + n_channels) + 24) + 8 * n_latent;
}
