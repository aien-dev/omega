// GENERATED by src/synapse/syn_gen.sh from syn_layout.lst and syn_codec.osc.in. Do not edit; edit the .in or the list.
// Synapse binary codec v2 in Omega (aien-dev/synapse ADR 0003 section 9 step 33, J1).
// Entry: syn_codec(inp, w). Specification: synapse docs/J1_OMEGA_CODEC.md and the Rust codec
// crates/synapse-store/src/codec.rs (Reader, decode_record, CheckpointState::decode_content) with the
// synapse-core canonical encodings it embeds (crates/synapse-core/src/revision.rs). The shared corpus
// tests/synapse/j1-corpus/corpus.bin pins both directions.
//
// Two entries (W_ENTRY): 1 one WAL record (`CODEC_V2 | kind | body`, kinds 1..8; 9..11 are reserved by open
// synapse PRs and refused as an unknown record kind today), 2 the content of a binary checkpoint (the five
// maps and the optional revision section). Two modes (W_MODE):
//   1 decode: inp holds the bytes. Accepted bytes are written as a logical form (LF) into the LF region and
//     W_LF_N holds its length. Refused bytes leave W_ERR = the CodecRefusal kind (1..9, declaration order)
//     with W_ERR_AT / W_ERR_X / W_ERR_Y / W_ERR_FIELD as the corpus records them: Truncated (at, need),
//     LengthOverCap (at, declared, cap), TrailingBytes (at, count), UnknownTag (at, tag, field), InvalidUtf8
//     (at), VersionUnsupported (found), NotCanonical (at, field), InvalidRepoId (at), EmbeddedMalformed
//     (at, code: 1 EnvelopeMalformed 2 EnvelopeVersionUnsupported, field). Offsets are relative to the record
//     being read (a revision record inside a checkpoint restarts at 0, as the Rust decoder's nested Reader).
//   2 encode: the LF region (W_LF_N cells) holds a logical form; the bytes go to the output region, one byte
//     per cell, W_OUT their count. A logical form that is not a value of the Rust types is refused with an
//     encode kind (20..27); like the Rust encoder, encode does not apply the decoder's length caps.
// Logical form: a token is a header cell `type | len << 8` then len cells; scalars (u16, u64, bool, tag,
// count) have len 1, byte runs (fixed arrays, strings, repository ids, byte strings) one cell per byte.
// Field order is the Rust field order; version bytes and length prefixes of embedded encodings are not in it.
// A checkpoint's revision section is always present in the LF (count 0 when the bytes hold none).
//
// The reader rules are the Rust ones. WAL rules (W_CORE = 0): a byte run length is checked against W_CAP and
// then the input; a sequence count against the cap (count x minimum encoded size, count x size_of) and then
// the input; tags out of range are UnknownTag at the tag byte. Inside an embedded synapse-core encoding
// (W_CORE = 1) every failure is EnvelopeMalformed, except a revision content version other than 2
// (EnvelopeVersionUnsupported); fail() turns it into EmbeddedMalformed at the embedding's length prefix.
// The first refusal wins: every primitive is a no-op once W_ERR is set.
//
// LIMITS (read before adding a record kind):
// - Functions: an OSC unit holds at most 32 functions (OSC_MAX_FUNCS, src/compiler/osc_ir.h), and this unit
//   uses all 32 (the driver prints "unit: N of 32 functions"). Record kinds 9, 10 and 11
//   (reserved by open synapse PRs) must land as `if k == N` arms inside record() built from the existing
//   helpers (fint, ftag, fcount, frun, ids, emb_open/emb_close, ...); a new helper function does not fit
//   until one is merged away or the unit is split.
// - Input: inputs above INPUT_MAX (1,000,000) bytes, encode logical forms above INPUT_MAX cells, LF regions
//   above 4 x INPUT_MAX cells and output regions above INPUT_MAX cells are refused LIMIT (loop bound LOOP_MAX).
// - Packing: emb_open keeps a region's end, base and prefix offset in one word, 20 bits each, so every
//   position must stay below 2^20 = 1,048,576. syn_gen.sh refuses a layout with INPUT_MAX > MASK20, and
//   syn_codec() also refuses LIMIT for an input or output region above MASK20.
// - Scope: the record layer only. Frame headers, CRCs, the SHA-256 chain and checkpoint roots are not here.

fn fail(w: cells, kf: u64, at: u64, x: u64) {
    if w[7] != 0 { return; }
    let k: u64 = kf & 255;
    if w[15] != 0 && (k < 20 || k == 98) {
        w[7] = 9;
        w[8] = w[23] - w[14];
        if k == 98 { w[9] = 2; } else { w[9] = 1; }
        w[10] = 0;
        w[11] = w[24];
        return;
    }
    w[7] = k;
    if k < 20 { w[8] = at - w[14]; } else { w[8] = at; }
    w[9] = x;
    if k == 2 { w[10] = w[5]; } else { w[10] = 0; }
    w[11] = kf >> 8;
}

// Decode: k more bytes must remain in the region, else Truncated (at the cursor, need the shortfall).
fn need(w: cells, k: u64) -> u64 {
    if w[7] != 0 { return 1; }
    let rem: u64 = w[13] - w[12];
    if k > rem {
        fail(w, 1, w[12], k - rem);
        return 1;
    }
    return 0;
}

// Decode: nb little-endian bytes at the cursor (need() checked them).
fn rdle(inp: bytes, w: cells, nb: u64) -> u64 {
    let p: u64 = w[12];
    let mut v: u64 = 0;
    let mut i: u64 = 0;
    while i < nb bound 8 {
        v = v | (inp[p + i] << (i * 8));
        i = i + 1;
    }
    w[12] = p + nb;
    return v;
}

// Decode: append one LF cell.
fn lfput(w: cells, v: u64) {
    if w[7] != 0 { return; }
    let n: u64 = w[17];
    if n >= w[20] {
        fail(w, 32, n, 0);
        return;
    }
    w[w[19] + n] = v;
    w[17] = n + 1;
}

// Encode: the next LF cell.
fn lfget(w: cells) -> u64 {
    if w[7] != 0 { return 0; }
    let i: u64 = w[16];
    if i >= w[17] {
        fail(w, 21, i, 0);
        return 0;
    }
    w[16] = i + 1;
    return w[w[19] + i];
}

// Encode: write v as nb little-endian bytes.
fn outle(w: cells, v: u64, nb: u64) {
    let mut j: u64 = 0;
    while j < nb && w[7] == 0 bound 8 {
        let o: u64 = w[18];
        if o >= w[22] {
            fail(w, 25, o, 0);
        } else {
            w[w[21] + o] = (v >> (j * 8)) & 255;
            w[18] = o + 1;
        }
        j = j + 1;
    }
}

// Stream byte i: the input in decode, LF cell i in encode (byte runs and keys are checked there).
fn sb(inp: bytes, w: cells, i: u64) -> u64 {
    if w[4] == 1 { return inp[i]; }
    return w[w[19] + i];
}

// 1 when stream bytes [s, s + n) are UTF-8 under the Rust std::str::from_utf8 rules, else 0.
fn utf8ok(inp: bytes, w: cells, s: u64, n: u64) -> u64 {
    let e: u64 = s + n;
    let mut i: u64 = s;
    let mut ok: u64 = 1;
    while i < e && ok == 1 bound 1000000 {
        let c: u64 = sb(inp, w, i);
        if c < 128 {
            i = i + 1;
        } else {
            let mut k: u64 = 0;
            let mut lo: u64 = 128;
            let mut hi: u64 = 191;
            if c >= 194 && c <= 223 {
                k = 1;
            } else if c == 224 {
                k = 2;
                lo = 160;
            } else if c >= 225 && c <= 236 {
                k = 2;
            } else if c == 237 {
                k = 2;
                hi = 159;
            } else if c >= 238 && c <= 239 {
                k = 2;
            } else if c == 240 {
                k = 3;
                lo = 144;
            } else if c >= 241 && c <= 243 {
                k = 3;
            } else if c == 244 {
                k = 3;
                hi = 143;
            }
            if k == 0 || i + k >= e {
                ok = 0;
            } else {
                let c1: u64 = sb(inp, w, i + 1);
                if c1 < lo || c1 > hi { ok = 0; }
                if k >= 2 {
                    let c2: u64 = sb(inp, w, i + 2);
                    if c2 < 128 || c2 > 191 { ok = 0; }
                }
                if k == 3 {
                    let c3: u64 = sb(inp, w, i + 3);
                    if c3 < 128 || c3 > 191 { ok = 0; }
                }
                i = i + k + 1;
            }
        }
    }
    return ok;
}

// 1 when stream bytes [s, s + n) are a RepoId (synapse-core RepoId::new): 1..=128 bytes of ASCII
// alphanumerics and - _ . /, not starting or ending with /, no // and no .., else 0.
fn repook(inp: bytes, w: cells, s: u64, n: u64) -> u64 {
    if n == 0 || n > 128 { return 0; }
    if sb(inp, w, s) == 47 || sb(inp, w, s + n - 1) == 47 { return 0; }
    let mut i: u64 = 0;
    let mut prev: u64 = 0;
    let mut ok: u64 = 1;
    while i < n && ok == 1 bound 128 {
        let c: u64 = sb(inp, w, s + i);
        let mut alnum: u64 = 0;
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { alnum = 1; }
        if alnum == 0 && c != 45 && c != 95 && c != 46 && c != 47 { ok = 0; }
        if (c == 47 || c == 46) && prev == c { ok = 0; }
        prev = c;
        i = i + 1;
    }
    return ok;
}

// A little-endian integer field (desc = type | byte count << 8). Returns its value.
fn fint(inp: bytes, w: cells, d: u64) -> u64 {
    if w[7] != 0 { return 0; }
    let t: u64 = d & 255;
    let nb: u64 = d >> 8;
    if w[4] == 1 {
        if need(w, nb) != 0 { return 0; }
        let v: u64 = rdle(inp, w, nb);
        lfput(w, t + 256);
        lfput(w, v);
        return v;
    }
    let h: u64 = lfget(w);
    let ev: u64 = lfget(w);
    if w[7] != 0 { return 0; }
    if h != t + 256 {
        fail(w, 20, w[16] - 2, h);
        return 0;
    }
    if nb < 8 && (ev >> (nb * 8)) != 0 {
        fail(w, 22, w[16] - 1, ev);
        return 0;
    }
    outle(w, ev, nb);
    return ev;
}

// A one-byte tag (desc = field | lo << 8 | hi << 16 | LF type << 24): outside lo..=hi is UnknownTag at the
// tag byte (decode) or LF_VALUE (encode). Returns the tag.
fn ftag(inp: bytes, w: cells, d: u64) -> u64 {
    if w[7] != 0 { return 0; }
    let f: u64 = d & 255;
    let lo: u64 = (d >> 8) & 255;
    let hi: u64 = (d >> 16) & 255;
    let t: u64 = d >> 24;
    if w[4] == 1 {
        let at: u64 = w[12];
        if need(w, 1) != 0 { return 0; }
        let v: u64 = rdle(inp, w, 1);
        if v < lo || v > hi {
            fail(w, 4 | (f << 8), at, v);
            return 0;
        }
        lfput(w, t + 256);
        lfput(w, v);
        return v;
    }
    let h: u64 = lfget(w);
    let ev: u64 = lfget(w);
    if w[7] != 0 { return 0; }
    if h != t + 256 {
        fail(w, 20, w[16] - 2, h);
        return 0;
    }
    if ev < lo || ev > hi {
        fail(w, 22, w[16] - 1, ev);
        return 0;
    }
    outle(w, ev, 1);
    return ev;
}

// A u32 sequence count. WAL rules: min = minimum encoded item size, t2 = size_of the item
// (Reader::vec). synapse-core rules: min as above, t2 = the count cap (0: none) (Reader::count).
// Returns the count; every caller's loop is bounded by it.
fn fcount(inp: bytes, w: cells, min: u64, t2: u64) -> u64 {
    if w[7] != 0 { return 0; }
    if w[4] == 1 {
        let at: u64 = w[12];
        if need(w, 4) != 0 { return 0; }
        let n: u64 = rdle(inp, w, 4);
        let rem: u64 = w[13] - w[12];
        let nd: u64 = n * min;
        if w[15] == 0 {
            if nd > w[5] || n * t2 > w[5] {
                fail(w, 2, at, n);
                return 0;
            }
            if nd > rem {
                fail(w, 1, w[12], nd - rem);
                return 0;
            }
        } else {
            if (t2 != 0 && n > t2) || nd > rem {
                fail(w, 1, w[12], 0);
                return 0;
            }
        }
        lfput(w, 267);
        lfput(w, n);
        return n;
    }
    let h: u64 = lfget(w);
    let en: u64 = lfget(w);
    if w[7] != 0 { return 0; }
    if h != 267 {
        fail(w, 20, w[16] - 2, h);
        return 0;
    }
    if en > w[17] - w[16] {
        fail(w, 21, w[16] - 1, en);
        return 0;
    }
    outle(w, en, 4);
    return en;
}

// A byte run (desc = type | arg << 8): T_FIX has arg bytes and no prefix; T_STR, T_REPO and T_BYTES have
// a u32 length (WAL: capped by W_CAP; synapse-core: capped by arg). Strings must be UTF-8, repository ids
// a RepoId (InvalidRepoId at the length prefix). Returns the byte count.
fn frun(inp: bytes, w: cells, d: u64) -> u64 {
    if w[7] != 0 { return 0; }
    let t: u64 = d & 255;
    let arg: u64 = d >> 8;
    if w[4] == 1 {
        let at: u64 = w[12];
        let mut n: u64 = arg;
        if t != 7 {
            if need(w, 4) != 0 { return 0; }
            n = rdle(inp, w, 4);
            let rem: u64 = w[13] - w[12];
            if w[15] == 0 {
                if n > w[5] {
                    fail(w, 2, at, n);
                    return 0;
                }
                if n > rem {
                    fail(w, 1, w[12], n - rem);
                    return 0;
                }
            } else {
                if n > arg || n > rem {
                    fail(w, 1, w[12], 0);
                    return 0;
                }
            }
        } else {
            if need(w, n) != 0 { return 0; }
        }
        let s: u64 = w[12];
        if t == 8 || t == 10 {
            if utf8ok(inp, w, s, n) == 0 {
                fail(w, 5, s, 0);
                return 0;
            }
            if t == 10 && repook(inp, w, s, n) == 0 {
                fail(w, 8, at, 0);
                return 0;
            }
        }
        lfput(w, t | (n << 8));
        let mut i: u64 = 0;
        while i < n && w[7] == 0 bound 1000000 {
            lfput(w, inp[s + i]);
            i = i + 1;
        }
        w[12] = s + n;
        return n;
    }
    let h: u64 = lfget(w);
    if w[7] != 0 { return 0; }
    let en: u64 = h >> 8;
    let s2: u64 = w[16];
    if (h & 255) != t || (t == 7 && en != arg) {
        fail(w, 20, s2 - 1, h);
        return 0;
    }
    if en > w[17] - s2 {
        fail(w, 21, s2 - 1, en);
        return 0;
    }
    let b: u64 = w[19] + s2;
    let mut j: u64 = 0;
    while j < en && w[7] == 0 bound 1000000 {
        if w[b + j] > 255 { fail(w, 22, s2 + j, w[b + j]); }
        j = j + 1;
    }
    if w[7] != 0 { return 0; }
    if t == 8 || t == 10 {
        if utf8ok(inp, w, s2, en) == 0 {
            fail(w, 23, s2 - 1, 0);
            return 0;
        }
        if t == 10 && repook(inp, w, s2, en) == 0 {
            fail(w, 24, s2 - 1, 0);
            return 0;
        }
    }
    if t != 7 { outle(w, en, 4); }
    let mut q: u64 = 0;
    while q < en && w[7] == 0 bound 1000000 {
        outle(w, w[b + q], 1);
        q = q + 1;
    }
    w[16] = s2 + en;
    return en;
}

// Open a length-prefixed region. f = a field id: an embedded synapse-core encoding (WAL length rules for
// the prefix, synapse-core rules inside); EMB_CORE: the inner content length of an envelope v2
// (synapse-core rules); EMB_REV: a checkpoint revision record (WAL rules; offsets restart at its start).
// Returns the save word for emb_close: old end | old base << 20 | prefix offset << 40.
fn emb_open(inp: bytes, w: cells, f: u64) -> u64 {
    if w[7] != 0 { return 0; }
    if w[4] == 2 {
        let o: u64 = w[18];
        outle(w, 0, 4);
        return o << 40;
    }
    let at: u64 = w[12];
    if need(w, 4) != 0 { return 0; }
    let n: u64 = rdle(inp, w, 4);
    let rem: u64 = w[13] - w[12];
    if f == 0 {
        if n > rem {
            fail(w, 1, w[12], 0);
            return 0;
        }
    } else {
        if n > w[5] {
            fail(w, 2, at, n);
            return 0;
        }
        if n > rem {
            fail(w, 1, w[12], n - rem);
            return 0;
        }
    }
    let save: u64 = w[13] | (w[14] << 20) | (at << 40);
    w[13] = w[12] + n;
    if f == 255 {
        w[14] = w[12];
    } else if f != 0 {
        w[15] = 1;
        w[23] = at;
        w[24] = f;
    }
    return save;
}

// Close the region emb_open opened. Decode: the region must be used up (synapse-core finish; a revision
// record checks its own end), then end and base come back. Encode: the length prefix is written.
fn emb_close(w: cells, save: u64, f: u64) {
    if w[7] != 0 { return; }
    if w[4] == 1 {
        if f != 255 && w[12] != w[13] {
            fail(w, 3, w[12], w[13] - w[12]);
            return;
        }
        w[13] = save & 1048575;
        w[14] = (save >> 20) & 1048575;
        if f != 0 && f != 255 { w[15] = 0; }
        return;
    }
    let at: u64 = save >> 40;
    let n: u64 = w[18] - at - 4;
    let b: u64 = w[21] + at;
    w[b] = n & 255;
    w[b + 1] = (n >> 8) & 255;
    w[b + 2] = (n >> 16) & 255;
    w[b + 3] = (n >> 24) & 255;
}

// A count then that many 32-byte ids (fcount rules for min and t2).
fn ids(inp: bytes, w: cells, min: u64, t2: u64) {
    let n: u64 = fcount(inp, w, min, t2);
    let mut i: u64 = 0;
    while i < n && w[7] == 0 bound 1000000 {
        frun(inp, w, 8199);
        i = i + 1;
    }
}

fn attachment(inp: bytes, w: cells) {
    frun(inp, w, 8);
    ftag(inp, w, 83951617);
    frun(inp, w, 8199);
    frun(inp, w, 8);
}

fn attachments(inp: bytes, w: cells) {
    let n: u64 = fcount(inp, w, 41, 88);
    let mut i: u64 = 0;
    while i < n && w[7] == 0 bound 1000000 {
        attachment(inp, w);
        i = i + 1;
    }
}

// One path mutation: path, op tag (1 upsert: mode tag, blob digest, size; 2 delete). The same layout in the
// v1 envelope (WAL rules) and in revision content (synapse-core rules, path cap 2048).
fn mutation(inp: bytes, w: cells) {
    frun(inp, w, 524296);
    let op: u64 = ftag(inp, w, 100794627);
    if op == 1 {
        ftag(inp, w, 100860164);
        frun(inp, w, 8199);
        fint(inp, w, 2052);
    }
}

// A mutation list: count (min, t2 as fcount), then the mutations.
fn mutations(inp: bytes, w: cells, t2: u64) {
    let n: u64 = fcount(inp, w, 5, t2);
    let mut i: u64 = 0;
    while i < n && w[7] == 0 bound 1000000 {
        mutation(inp, w);
        i = i + 1;
    }
}

// ChangesetEnvelope v1 (get_envelope).
fn envelope(inp: bytes, w: cells) {
    fint(inp, w, 514);
    frun(inp, w, 32778);
    frun(inp, w, 5127);
    ids(inp, w, 32, 32);
    frun(inp, w, 8);
    frun(inp, w, 8199);
    fint(inp, w, 2052);
    frun(inp, w, 8);
    mutations(inp, w, 72);
    attachments(inp, w);
    frun(inp, w, 9);
}

fn review(inp: bytes, w: cells) {
    frun(inp, w, 8);
    ftag(inp, w, 83951617);
    frun(inp, w, 8);
    fint(inp, w, 2052);
}

fn projection(inp: bytes, w: cells) {
    frun(inp, w, 32778);
    fint(inp, w, 2052);
    frun(inp, w, 8199);
    frun(inp, w, 5127);
    frun(inp, w, 5127);
    frun(inp, w, 8);
    frun(inp, w, 8);
    frun(inp, w, 8);
    frun(inp, w, 8199);
    ftag(inp, w, 83951617);
}

fn canonical(inp: bytes, w: cells) {
    frun(inp, w, 32778);
    frun(inp, w, 8);
    frun(inp, w, 5127);
    let opt: u64 = ftag(inp, w, 100728834);
    if opt == 1 { frun(inp, w, 8199); }
    frun(inp, w, 5127);
    fint(inp, w, 2052);
    let n: u64 = fcount(inp, w, 4, 24);
    let mut i: u64 = 0;
    while i < n && w[7] == 0 bound 1000000 {
        frun(inp, w, 8);
        i = i + 1;
    }
    fint(inp, w, 2052);
}

// StoredChangeset (get_stored).
fn stored(inp: bytes, w: cells) {
    frun(inp, w, 8199);
    fint(inp, w, 2052);
    envelope(inp, w);
    attachments(inp, w);
    let n: u64 = fcount(inp, w, 17, 64);
    let mut i: u64 = 0;
    while i < n && w[7] == 0 bound 1000000 {
        review(inp, w);
        i = i + 1;
    }
    fint(inp, w, 2052);
}

// Embedded ChangesetEnvelopeV2: u32 content length, content (u16 version 2, change id, base tree, parents,
// mutations, intent), then the authorship attestation.
fn env2(inp: bytes, w: cells) {
    let sv: u64 = emb_open(inp, w, 6);
    let sc: u64 = emb_open(inp, w, 0);
    if w[4] == 1 {
        if need(w, 2) == 0 {
            let ver: u64 = rdle(inp, w, 2);
            if ver != 2 { fail(w, 98, 0, ver); }
        }
    } else {
        outle(w, 2, 2);
    }
    frun(inp, w, 4103);
    frun(inp, w, 8199);
    ids(inp, w, 32, 0);
    mutations(inp, w, 0);
    frun(inp, w, 1048584);
    emb_close(w, sc, 0);
    frun(inp, w, 32778);
    frun(inp, w, 8199);
    frun(inp, w, 8199);
    frun(inp, w, 8199);
    fint(inp, w, 2052);
    frun(inp, w, 16391);
    emb_close(w, sv, 6);
}

// Embedded ChainPath: u8 depth 1..=16, then that many link digests.
fn chain(inp: bytes, w: cells) {
    let sv: u64 = emb_open(inp, w, 7);
    let n: u64 = ftag(inp, w, 185598208);
    let mut i: u64 = 0;
    while i < n && w[7] == 0 bound 16 {
        frun(inp, w, 8199);
        i = i + 1;
    }
    emb_close(w, sv, 7);
}

// Embedded ObsolescenceMarker.
fn marker(inp: bytes, w: cells) {
    let sv: u64 = emb_open(inp, w, 8);
    frun(inp, w, 32778);
    frun(inp, w, 4103);
    frun(inp, w, 8199);
    ids(inp, w, 32, 256);
    frun(inp, w, 8199);
    fint(inp, w, 2052);
    frun(inp, w, 16391);
    emb_close(w, sv, 8);
}

// One WAL record in [W_POS, W_END): version, kind, body, finish (decode_record). Returns the kind.
// Kinds 9..11 (reserved by open synapse PRs) slot in as one more `if k == N` arm and a wider D_KIND.
fn record(inp: bytes, w: cells) -> u64 {
    if w[7] != 0 { return 0; }
    if w[4] == 1 {
        if need(w, 1) != 0 { return 0; }
        let v: u64 = rdle(inp, w, 1);
        if v != 2 {
            fail(w, 6, w[14], v);
            return 0;
        }
    } else {
        outle(w, 2, 1);
    }
    let k: u64 = ftag(inp, w, 101187845);
    if k == 1 {
        envelope(inp, w);
        frun(inp, w, 8199);
        ids(inp, w, 32, 32);
    }
    if k == 2 {
        frun(inp, w, 8199);
        attachment(inp, w);
    }
    if k == 3 {
        frun(inp, w, 8199);
        review(inp, w);
    }
    if k == 4 { projection(inp, w); }
    if k == 5 { canonical(inp, w); }
    if k == 6 {
        frun(inp, w, 8199);
        fint(inp, w, 2052);
    }
    if k == 7 {
        env2(inp, w);
        chain(inp, w);
        fint(inp, w, 2052);
        ids(inp, w, 32, 32);
    }
    if k == 8 {
        marker(inp, w);
        chain(inp, w);
        fint(inp, w, 2052);
    }
    if w[4] == 1 && w[7] == 0 && w[12] != w[13] {
        fail(w, 3, w[12], w[13] - w[12]);
    }
    return k;
}

// Checkpoint map order: the entry at stream offset `at` must have a key strictly above the previous entry's
// (kf = key kind | field << 8). Keys: K_FIX32 the first 32 bytes; K_STR the leading repository id; K_STRFIX
// the repository id then the 32 bytes after it; K_U64 the u64 after the leading repository id. Decode
// refuses NotCanonical at the entry, encode LF_ORDER.
fn cmpkey(inp: bytes, w: cells, kf: u64, at: u64) {
    if w[7] != 0 { return; }
    if w[25] == 1 {
        let kind: u64 = kf & 255;
        let a: u64 = w[26];
        let mut dec: u64 = 0;
    if w[4] == 1 { dec = 1; }
        let mut c: u64 = 0;
        let mut pa: u64 = a;
        let mut pb: u64 = at;
        if dec == 0 {
            pa = a + 1;
            pb = at + 1;
        }
        if kind != 1 {
            let mut na: u64 = 0;
            let mut nb: u64 = 0;
            if dec == 1 {
                na = sb(inp, w, a) | (sb(inp, w, a + 1) << 8) | (sb(inp, w, a + 2) << 16) | (sb(inp, w, a + 3) << 24);
                nb = sb(inp, w, at) | (sb(inp, w, at + 1) << 8) | (sb(inp, w, at + 2) << 16) | (sb(inp, w, at + 3) << 24);
                pa = a + 4;
                pb = at + 4;
            } else {
                na = w[w[19] + a] >> 8;
                nb = w[w[19] + at] >> 8;
            }
            if kind == 4 {
                let mut va: u64 = 0;
                let mut vb: u64 = 0;
                if dec == 1 {
                    let mut i: u64 = 0;
                    while i < 8 bound 8 {
                        va = va | (sb(inp, w, pa + na + i) << (i * 8));
                        vb = vb | (sb(inp, w, pb + nb + i) << (i * 8));
                        i = i + 1;
                    }
                } else {
                    va = w[w[19] + pa + na + 1];
                    vb = w[w[19] + pb + nb + 1];
                }
                if va < vb { c = 1; } else { c = 2; }
            } else {
                let mut m: u64 = na;
                if nb < m { m = nb; }
                let mut j: u64 = 0;
                while j < m && c == 0 bound 128 {
                    let xa: u64 = sb(inp, w, pa + j);
                    let xb: u64 = sb(inp, w, pb + j);
                    if xa < xb { c = 1; }
                    if xa > xb { c = 2; }
                    j = j + 1;
                }
                if c == 0 && na < nb { c = 1; }
                if c == 0 && na > nb { c = 2; }
                if c == 0 && kind == 3 {
                    pa = pa + na;
                    pb = pb + nb;
                    if dec == 0 {
                        pa = pa + 1;
                        pb = pb + 1;
                    }
                }
                if c == 0 && kind == 2 { c = 2; }
            }
        }
        let mut q: u64 = 0;
        while q < 32 && c == 0 bound 32 {
            let ya: u64 = sb(inp, w, pa + q);
            let yb: u64 = sb(inp, w, pb + q);
            if ya < yb { c = 1; }
            if ya > yb { c = 2; }
            q = q + 1;
        }
        if c != 1 {
            if dec == 1 { fail(w, 7 | (kf >> 8 << 8), at, 0); } else { fail(w, 27, at, 0); }
            return;
        }
    }
    w[26] = at;
    w[25] = 1;
}

// Checkpoint content (CheckpointState::decode_content / encode_content).
fn ckpt(inp: bytes, w: cells) {
    let mut dec: u64 = 0;
    if w[4] == 1 { dec = 1; }
    if dec == 1 {
        if need(w, 1) != 0 { return; }
        let v: u64 = rdle(inp, w, 1);
        if v != 2 {
            fail(w, 6, 0, v);
            return;
        }
    } else {
        outle(w, 2, 1);
    }
    let mut at: u64 = 0;
    let n1: u64 = fcount(inp, w, 40, 1);
    w[25] = 0;
    let mut i1: u64 = 0;
    while i1 < n1 && w[7] == 0 bound 1000000 {
        at = w[12];
        if dec == 0 { at = w[16]; }
        stored(inp, w);
        cmpkey(inp, w, 1 | (9 << 8), at);
        i1 = i1 + 1;
    }
    let n2: u64 = fcount(inp, w, 76, 1);
    w[25] = 0;
    let mut i2: u64 = 0;
    while i2 < n2 && w[7] == 0 bound 1000000 {
        at = w[12];
        if dec == 0 { at = w[16]; }
        frun(inp, w, 32778);
        frun(inp, w, 8199);
        fint(inp, w, 2052);
        frun(inp, w, 8199);
        cmpkey(inp, w, 3 | (10 << 8), at);
        i2 = i2 + 1;
    }
    let n3: u64 = fcount(inp, w, 40, 1);
    w[25] = 0;
    let mut i3: u64 = 0;
    while i3 < n3 && w[7] == 0 bound 1000000 {
        at = w[12];
        if dec == 0 { at = w[16]; }
        frun(inp, w, 8199);
        cmpkey(inp, w, 1 | (11 << 8), at);
        fint(inp, w, 2052);
        i3 = i3 + 1;
    }
    let n4: u64 = fcount(inp, w, 12, 1);
    w[25] = 0;
    let mut i4: u64 = 0;
    while i4 < n4 && w[7] == 0 bound 1000000 {
        at = w[12];
        if dec == 0 { at = w[16]; }
        projection(inp, w);
        cmpkey(inp, w, 4 | (12 << 8), at);
        i4 = i4 + 1;
    }
    let n5: u64 = fcount(inp, w, 4, 1);
    w[25] = 0;
    let mut i5: u64 = 0;
    while i5 < n5 && w[7] == 0 bound 1000000 {
        at = w[12];
        if dec == 0 { at = w[16]; }
        canonical(inp, w);
        cmpkey(inp, w, 2 | (13 << 8), at);
        i5 = i5 + 1;
    }
    if w[7] != 0 { return; }
    // Revision section: in the bytes only when it holds records; always a count in the LF.
    let mut present: u64 = 1;
    if dec == 1 && w[12] >= w[13] {
        present = 0;
        lfput(w, 267);
        lfput(w, 0);
    }
    if dec == 0 {
        let l: u64 = w[16];
        if l + 1 < w[17] && w[w[19] + l] == 267 && w[w[19] + l + 1] == 0 {
            present = 0;
            w[16] = l + 2;
        }
    }
    if present == 1 {
        let sat: u64 = w[12];
        let n6: u64 = fcount(inp, w, 12, 1);
        if dec == 1 && w[7] == 0 && n6 == 0 {
            fail(w, 7 | (14 << 8), sat, 0);
            return;
        }
        let mut prev: u64 = 0;
        let mut has: u64 = 0;
        let mut i6: u64 = 0;
        while i6 < n6 && w[7] == 0 bound 1000000 {
            let rat: u64 = w[12];
            let seq: u64 = fint(inp, w, 2052);
            if dec == 1 && w[7] == 0 && ((has == 1 && prev >= seq) || seq > w[6]) {
                fail(w, 7 | (14 << 8), rat, 0);
            }
            prev = seq;
            has = 1;
            let tag_at: u64 = w[12] + 5;
            let sv: u64 = emb_open(inp, w, 255);
            let k: u64 = record(inp, w);
            emb_close(w, sv, 255);
            if dec == 1 && w[7] == 0 && k != 7 && k != 8 {
                fail(w, 3844, tag_at, k);
            }
            i6 = i6 + 1;
        }
    }
    if dec == 1 && w[7] == 0 && w[12] != w[13] {
        fail(w, 3, w[12], w[13] - w[12]);
    }
}

// Entry. Header checks (ABI, regions inside w and apart, input within the loop bound), state reset,
// one record or one checkpoint content, then (encode) the whole LF must have been used.
fn syn_codec(inp: bytes, w: cells) -> u64 {
    if w.len < 32 { return 30; }
    w[7] = 0;
    w[8] = 0;
    w[9] = 0;
    w[10] = 0;
    w[11] = 0;
    let mode: u64 = w[4];
    let lb: u64 = w[19];
    let lc: u64 = w[20];
    let ob: u64 = w[21];
    let oc: u64 = w[22];
    let mut bad: u64 = 0;
    if w[0] != 1398361674 || w[1] != 1 || w[2] != w.len { bad = 1; }
    if w[3] != 1 && w[3] != 2 { bad = 1; }
    if mode != 1 && mode != 2 { bad = 1; }
    if lb < 32 || lb > w.len || lc > w.len - lb { bad = 1; }
    if bad == 0 && (ob < 32 || ob > w.len || oc > w.len - ob) { bad = 1; }
    if bad == 0 && oc != 0 && lc != 0 && ob < lb + lc && lb < ob + oc { bad = 1; }
    if bad == 0 && mode == 2 && w[17] > lc { bad = 1; }
    if bad == 1 {
        w[7] = 30;
        return 30;
    }
    // The second line keeps every packed position (emb_open) inside 20 bits even if INPUT_MAX grows.
    if inp.len > 1000000 || lc > 1000000 * 4 || oc > 1000000 ||
       inp.len > 1048575 || oc > 1048575 {
        w[7] = 31;
        return 31;
    }
    if mode == 2 && w[17] > 1000000 {
        w[7] = 31;
        return 31;
    }
    w[12] = 0;
    w[13] = inp.len;
    w[14] = 0;
    w[15] = 0;
    w[16] = 0;
    w[18] = 0;
    w[23] = 0;
    w[24] = 0;
    w[25] = 0;
    w[26] = 0;
    if mode == 1 { w[17] = 0; }
    if w[3] == 1 {
        record(inp, w);
    } else {
        if mode == 1 { w[5] = inp.len; }
        ckpt(inp, w);
    }
    if mode == 2 && w[7] == 0 && w[16] != w[17] {
        fail(w, 26, w[16], w[17] - w[16]);
    }
    return w[7];
}
