    if n >= 64 { return werr(w, 212); }
    w[33] = n + 1;
    w[8] = kind;
    w[11] = w[11] + 1;
    w[896] = 2;
    w[46] = 2;
    return 102;
}

// Cell of the latest earlier assignment entry of this command named inp[ns..ns+nl), or 0. Only in a command with no
// command word, so that `A=1 B=$A` sees the new A (a prefix assignment sees the old value).
fn find_prior(inp: bytes, w: cells, ns: u64, nl: u64) -> u64 {
    let pb: u64 = 832 + w[30] * 4;
    if w[576 + (w[pb] + w[31]) * 8 + 3] != 0 { return 0; }
    let cb: u64 = cbase(w);
    let na: u64 = w[cb + 1];
    let mut hit: u64 = 0;
    let mut j: u64 = 0;
    while j + 1 < na bound 16 {
        let e: u64 = cb + 68 + j * 4;
        if w[e + 1] == nl {
            let mut same: u64 = 1;
            let mut i: u64 = 0;
            while i < nl && same == 1 bound 4096 {
                if inp[ns + i] != w[3264 + w[e] + i] { same = 0; }
                i = i + 1;
            }
            if same == 1 { hit = e; }
        }
        j = j + 1;
    }
    return hit;
}

// A reference was parsed (dollar): decide how its value is fetched. q is the quote state.
fn begin_ref(inp: bytes, w: cells, q: u64) -> u64 {
    let rk: u64 = w[22];
    let wm: u64 = w[45];
    let mut vm: u64 = 0;
    if q == 0 && wm != 2 && wm != 4 { vm = 1; }
    w[21] = vm;
    // In "": $@ marks bit 1 and $* bit 2; a scalar reference marks bit 2 only when a value byte is copied (xval),
    // so "$e$@" with no positionals gives no field (bash) while "$e" alone still gives one empty field.
    if q == 2 {
        if rk == 8 { w[15] = w[15] | 1; }
        if rk == 9 { w[15] = w[15] | 2; }
    }
    if rk >= 8 {
        let mut lk: u64 = 6;
        if vm == 1 { lk = 5; }
        if rk == 8 && q == 2 && wm != 2 && wm != 4 { lk = 7; }
        w[22] = lk;
        return request(w, 5);
    }
    if rk == 1 && wm == 2 {
        let hit: u64 = find_prior(inp, w, w[9], w[10]);
        if hit != 0 {
            w[19] = 3264 + w[hit + 2];
            w[20] = 3264 + w[hit + 2] + w[hit + 3];
            w[46] = 1;
            return 0;
        }
    }
    return request(w, rk);
}

// The host answered: STAGING holds the value (kind 1 to 4, or one positional of a list) or the positional count.
fn answer(w: cells) -> u64 {
    let f: u64 = w[896];
    if f > 1 { return 102; }
    if w[8] == 5 {
        let np: u64 = w[896 + 2];
        w[24] = np;
        w[23] = 1;
        if np == 0 {
            w[47] = w[18];
            w[46] = 0;
            return 0;
        }
        w[9] = 1;
        w[10] = 0;
        return request(w, 3);
    }
    let mut ln: u64 = 0;
    if f == 1 { ln = w[896 + 1]; }
    if ln > 1024 { return werr(w, 211); }
    w[19] = 896 + 4;
    w[20] = 896 + 4 + ln;
    w[46] = 1;
    if w[22] == 7 { fopen_(w); }
    return 0;
}

// The value was copied completely: next positional of a list (with its separator), or back to the raw bytes.
fn vdone(w: cells) -> u64 {
    let rk: u64 = w[22];
    let k: u64 = w[23];
    if rk >= 5 && k < w[24] {
        let mut r: u64 = 0;
        if rk == 6 {
            r = lit(w, 32);
        } else {
            r = fclose(w);
        }
        if r != 0 { return r; }
        w[23] = k + 1;
        w[9] = k + 1;
        w[10] = 0;
        return request(w, 3);
    }
    w[47] = w[18];
    w[46] = 0;
    return 0;
}

// One value byte.
fn xval(w: cells) -> u64 {
    let cur: u64 = w[19];
    if cur >= w[20] { return vdone(w); }
    let c: u64 = w[cur];
    if c == 0 || c > 255 { return werr(w, 244); }
    w[19] = cur + 1;
    if w[21] == 1 { return sbyte(w, c); }
    if w[12] == 2 { w[15] = w[15] | 2; }
    return lit(w, c);
}

// The word is complete: close its field, finish the assignment value, check the redirection target.
fn wend(w: cells) -> u64 {
    let r: u64 = fclose(w);
    if r != 0 { return r; }
    let wm: u64 = w[45];
    if wm == 2 {
        let e: u64 = cbase(w) + 4 + 64 + (w[cbase(w) + 1] - 1) * 4;
        w[e + 3] = w[42] - w[e + 2];
    }
    if wm == 3 && w[16] == 0 { return werr(w, 243); }
    w[45] = 0;
    w[32] = w[32] + 1;
    return 1;
}

// One raw byte of the word (or its end). 0 = go on, 1 = word complete, 102 = variable wanted, >= 200 = refusal.
fn xraw(inp: bytes, w: cells) -> u64 {
    let tb: u64 = 64 + w[32] * 4;
    let e: u64 = w[tb + 1] + w[tb + 2];
    let p: u64 = w[47];
    if p >= e { return wend(w); }
    let c: u64 = inp[p];
    let q: u64 = w[12];
    w[47] = p + 1;
    if q == 1 {
        if c == 39 {
            w[12] = 0;
            fopen_(w);
            return 0;
        }
        return lit(w, c);
    }
    if c == 92 && p + 1 < e {
        let d: u64 = inp[p + 1];
        if d == 10 {
            w[47] = p + 2;
            return 0;
        }
        if q == 0 {
            w[47] = p + 2;
            return lit(w, d);
        }
        if d == 36 || d == 34 || d == 92 || d == 96 {
            w[47] = p + 2;
            w[15] = w[15] | 2;
            return lit(w, d);
        }
    }
    if q == 2 && c == 34 {
        w[12] = 0;
        let f: u64 = w[15];
        if (f & 2) != 0 || (f & 1) == 0 { fopen_(w); }
        w[15] = 0;
        return 0;
    }
    if q == 0 && c == 34 {
        w[12] = 2;
        w[15] = 0;
        return 0;
    }
    if q == 0 && c == 39 {
        w[12] = 1;
        return 0;
    }
    if c == 36 && dollar(inp, w, p, e) == 1 {
        w[47] = p;
        return begin_ref(inp, w, q);
    }
    if q == 2 { w[15] = w[15] | 2; }
    return lit(w, c);
}

// Start a word: mode 1 argv, 2 assignment value, 3 redirection target, 4 argv word NAME=v of export (expanded as
// an assignment: no splitting, no glob refusal of values, $@ joined); raw cursor at pos.
fn wset(w: cells, mode: u64, pos: u64) {
    w[45] = mode;
    w[46] = 0;
    w[47] = pos;
    w[12] = 0;
    w[13] = 0;
    w[15] = 0;
    w[16] = 0;
}

// The assignment word at token tb: copy its name to OUT, record the entry, start its value.
fn start_assign(inp: bytes, w: cells, tb: u64) -> u64 {
    let s: u64 = w[tb + 1];
    let aux: u64 = w[tb + 3];
    if aux <= s + 1 { return fail(w, 217, s); }
    let nl: u64 = aux - 1 - s;
    let cb: u64 = cbase(w);
    let na: u64 = w[cb + 1];
    if na >= 16 { return fail(w, 207, s); }
    let o: u64 = w[42];
    if o + nl > 8192 { return fail(w, 210, s); }
    let mut i: u64 = 0;
    while i < nl bound 4096 {
        w[3264 + o + i] = inp[s + i];
        i = i + 1;
    }
    w[42] = o + nl;
    let e: u64 = cb + 68 + na * 4;
    w[e] = o;
    w[e + 1] = nl;
    w[e + 2] = o + nl;
    w[e + 3] = 0;
    w[cb + 1] = na + 1;
    wset(w, 2, aux);
    return 0;
}

// The redirection operator at token t (kind k): record the entry; N>&M is complete, others start the target word.
fn start_redir(inp: bytes, w: cells, t: u64, k: u64) -> u64 {
    let tb: u64 = 64 + t * 4;
    let s: u64 = w[tb + 1];
    let cb: u64 = cbase(w);
    let r: u64 = w[cb + 2];
    if r >= 8 { return fail(w, 208, s); }
    if t + 1 >= w[17] { return fail(w, 217, s); }
    let ub: u64 = tb + 4;
    if (w[ub] & 255) != 1 { return fail(w, 217, s); }
    w[cb + 2] = r + 1;
    let e: u64 = cb + 132 + r * 4;
    let mut kind: u64 = 1;
    if k == 7 { kind = 2; }
    if k == 8 { kind = 3; }
    if k == 10 || k == 11 { kind = 4; }
    w[e] = kind;
    w[e + 1] = w[tb + 3];
    if kind == 4 {
        let d: u64 = inp[w[ub + 1]];
        if d < 48 || d > 50 { return fail(w, 217, s); }
        w[e + 2] = d - 48;
        w[32] = t + 2;
        return 0;
    }
    wset(w, 3, w[ub + 1]);
    w[32] = t + 1;
    return 0;
}

// The first bytes of an OUT field packed big-endian; 0 for an empty field or one longer than 8 bytes.
fn pack8o(w: cells, off: u64, n: u64) -> u64 {
    if n == 0 || n > 8 { return 0; }
    let mut v: u64 = 0;
    let mut i: u64 = 0;
    while i < n bound 8 {
        v = (v << 8) | w[3264 + off + i];
        i = i + 1;
    }
    return v;
}

// 1 to 6 builtin id (cd pwd printf export unset exit), 99 unsupported builtin, 0 external.
fn classify(v: u64) -> u64 {
    if v == 0x6364 { return 1; }
    if v == 0x707764 { return 2; }
    if v == 0x7072696e7466 { return 3; }
    if v == 0x6578706f7274 { return 4; }
    if v == 0x756e736574 { return 5; }
    if v == 0x65786974 { return 6; }
    if v == 0x736574 || v == 0x6576616c || v == 0x65786563 || v == 0x2e || v == 0x736f75726365 { return 99; }
    if v == 0x74726170 || v == 0x7368696674 || v == 0x72656164 || v == 0x72657475726e { return 99; }
    if v == 0x627265616b || v == 0x636f6e74696e7565 || v == 0x6c6f63616c { return 99; }
    if v == 0x726561646f6e6c79 || v == 0x616c696173 || v == 0x77616974 { return 99; }
    // more bash builtins: : declare typeset let command type umask hash ulimit getopts jobs pushd popd dirs history
    // unalias fg bg builtin enable shopt mapfile times caller disown suspend logout bind help compgen complete
    if v == 0x3a || v == 0x6465636c617265 || v == 0x74797065736574 || v == 0x6c6574 || v == 0x636f6d6d616e64 { return 99; }
    if v == 0x74797065 || v == 0x756d61736b || v == 0x68617368 || v == 0x756c696d6974 || v == 0x6765746f707473 { return 99; }
    if v == 0x6a6f6273 || v == 0x7075736864 || v == 0x706f7064 || v == 0x64697273 || v == 0x686973746f7279 { return 99; }
    if v == 0x756e616c696173 || v == 0x6667 || v == 0x6267 || v == 0x6275696c74696e || v == 0x656e61626c65 { return 99; }
    if v == 0x73686f7074 || v == 0x6d617066696c65 || v == 0x74696d6573 || v == 0x63616c6c6572 || v == 0x6469736f776e { return 99; }
    if v == 0x73757370656e64 || v == 0x6c6f676f7574 || v == 0x62696e64 || v == 0x68656c70 || v == 0x636f6d7067656e { return 99; }
    if v == 0x636f6d706c657465 { return 99; }
    return 0;
}

// The pipeline is fully expanded: header, state, status.
fn pipe_ready(w: cells) -> u64 {
    let pb: u64 = 832 + w[30] * 4;
    w[1928] = 1330791761;
    w[1928 + 1] = w[pb + 1];
    w[1928 + 2] = w[pb + 2];
    w[1928 + 3] = 0;
    w[1928 + 4] = w[42];
    w[1928 + 5] = 1;
    w[29] = 2;
    return 103;
}

// All tokens of the command are expanded: classify argv[0], go to the next command or finish the pipeline.
fn cmd_end(w: cells) -> u64 {
    let cb: u64 = cbase(w);
    if w[cb] > 0 {
        let b: u64 = classify(pack8o(w, w[cb + 4], w[cb + 5]));
        if b == 99 { return fail(w, 239, w[44]); }
        w[cb + 3] = b;
    }
    let pb: u64 = 832 + w[30] * 4;
    let c: u64 = w[31] + 1;
    if c >= w[pb + 1] { return pipe_ready(w); }
    w[31] = c;
    w[32] = w[576 + (w[pb] + c) * 8];
    w[43] = 0;
    return 0;
}

// 1 when argv[0] of this command is the plain word `export` (raw bytes `export` then a blank, value `export`): bash
// expands its NAME=value arguments as assignments, so their values are not split (mode 4).
fn is_export(inp: bytes, w: cells) -> u64 {
    let cb: u64 = cbase(w);
    if w[cb] == 0 { return 0; }
    if pack8o(w, w[cb + 4], w[cb + 5]) != 0x6578706f7274 { return 0; }
    let a: u64 = w[44];
    if a + 6 >= inp.len { return 0; }
    let mut v: u64 = 0;
    let mut i: u64 = 0;
    while i < 6 bound 6 {
        v = (v << 8) | inp[a + i];
        i = i + 1;
    }
    if v != 0x6578706f7274 { return 0; }
    let d: u64 = inp[a + 6];
    if d == 32 || d == 9 { return 1; }
    return 0;
}

// Between words: classify the next token of the command and start it.
fn next_task(inp: bytes, w: cells) -> u64 {
    let pb: u64 = 832 + w[30] * 4;
    let cmb: u64 = 576 + (w[pb] + w[31]) * 8;
    let t: u64 = w[32];
    if t >= w[cmb + 1] { return cmd_end(w); }
    let tb: u64 = 64 + t * 4;
    let hdr: u64 = w[tb];
    let k: u64 = hdr & 255;
    if k == 1 {
        if ((hdr >> 8) & 16) != 0 && w[43] == 0 { return start_assign(inp, w, tb); }
        let mut m: u64 = 1;
        if ((hdr >> 8) & 16) != 0 && is_export(inp, w) == 1 { m = 4; }
        w[43] = 1;
        wset(w, m, w[tb + 1]);
        return 0;
    }
    if k == 6 || k == 7 || k == 8 || k == 10 || k == 11 { return start_redir(inp, w, t, k); }
    return fail(w, 217, w[tb + 1]);
}

// Begin pipeline p: clear its request block and the per-pipeline state.
fn pipe_begin(w: cells, p: u64) {
    let pb: u64 = 832 + p * 4;
    let n: u64 = 8 + w[pb + 1] * 164;
    let mut i: u64 = 0;
    while i < n bound 1320 {
        w[1928 + i] = 0;
        i = i + 1;
    }
    w[31] = 0;
    w[32] = w[576 + w[pb] * 8];
    w[33] = 0;
    w[42] = 0;
    w[43] = 0;
    w[45] = 0;
    w[46] = 0;
    w[29] = 1;
}

// Pick the next pipeline that runs (connector rules). 0 = begun, 104 = none left.
fn next_pipe(w: cells) -> u64 {
    let np: u64 = w[37];
    let mut p: u64 = w[30];
    let mut go: u64 = 0;
    while p < np && go == 0 bound 16 {
        go = 1;
        if p > 0 && w[25] == 0 {
            let cn: u64 = w[832 + (p - 1) * 4 + 2];
            let ls: u64 = w[3];
            if cn == 2 && ls != 0 { go = 0; }
            if cn == 3 && ls == 0 { go = 0; }
        }
        if go == 0 { p = p + 1; }
    }
    w[30] = p;
    if p >= np {
        w[29] = 3;
        return 104;
    }
    pipe_begin(w, p);
    return 0;
}

fn expand_run(inp: bytes, w: cells) -> u64 {
    let ac: u64 = abi_check(w);
    if ac != 0 { return ac; }
    if w[2] == 255 { return w[4]; }
    if w[34] != 4 { return 217; }
    if w[41] == 0 {
        for j in 29 .. 34 {
            w[j as u64] = 0;
        }
        for j in 12 .. 27 {
            if j != 17 && j != 25 { w[j as u64] = 0; }
        }
        w[41] = 1;
    }
    if w[29] > 3 || w[30] > w[37] { return 217; }
    if w[29] == 3 { return 104; }
    if w[29] == 2 {
        w[30] = w[30] + 1;
        w[29] = 0;
    }
    if w[29] == 0 {
        let nr: u64 = next_pipe(w);
        if nr != 0 { return nr; }
    }
    let mut n: u64 = 0;
    let mut rc: u64 = 0;
    while rc == 0 && n < 1024 bound 1024 {
        if w[45] == 0 {
            rc = next_task(inp, w);
        } else {
            let ph: u64 = w[46];
            if ph == 1 {
                rc = xval(w);
            } else {
                if ph == 2 {
                    rc = answer(w);
                } else {
                    rc = xraw(inp, w);
                }
            }
            if rc == 1 { rc = 0; }
        }
        n = n + 1;
    }
    if rc != 0 { return rc; }
    return 101;
}
