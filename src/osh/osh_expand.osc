// osh expander unit (aien-architecture#158, cut 4c): bounded, resumable parameter expansion, quote removal, field
// splitting and request-record writer. Entry: expand_run(inp, w). Contract: aien-protocols
// specs/osh-platform/OSH_PLATFORM_ABI.md (v1 DRAFT) sections 5 to 7; design: handoffs/osh-audit/E-parser-design.md
// section 4. Needs the external slices (OSC-EXT-BYTES).
//
// It reads the token records (lexer) and the command and pipeline tables (parser) the earlier units left in the same
// workspace, expands ONE pipeline at a time (the host runs it and updates $? before the next call), and writes the
// request record (ABI 7.1) at REQUEST, with the expanded bytes (1 byte per cell) at OUT.
//
// expand_run returns one status:
//   103 PIPELINE_READY  the request record is valid (header, ncmds blocks of 164 cells, OUT bytes); execute it, write
//                       the pipeline status to S_LAST_STATUS, then call expand_run again
//   104 COMPLETE        no pipeline of the list is left (also: a blank list)
//   102 NEED_VAR        a variable is wanted: S_VR_KIND (1 NAME at S_VR_A/S_VR_LEN in inp, 2 $?, 3 positional S_VR_A,
//                       4 $#, 5 positional count only) ; the host writes STAGING {found, len, npos, 0, bytes...} and calls
//                       expand_run again. The core writes STAGING[0] = 2 (unanswered) with the request; a repeated call
//                       while STAGING[0] is still above 1 returns 102 again and changes nothing (idempotent).
//   101 BUDGET_EXHAUSTED  1024 steps spent (a step is one raw byte, one value byte or one token), call again
//   209 CAP_FIELDS 210 CAP_OUT 211 CAP_VALUE 212 CAP_VARREQ 243 AMBIGUOUS_REDIRECT 244 VALUE_NUL 245 VALUE_GLOB
//   239 UNSUPPORTED_BUILTIN (argv[0] after expansion is set eval exec . source trap shift read return break continue
//   local readonly alias wait : declare typeset let command type umask hash ulimit getopts jobs pushd popd dirs
//   history unalias fg bg builtin enable shopt mapfile times caller disown suspend logout bind help compgen complete;
//   names over 8 bytes such as readarray are not caught)  213 WORKSPACE_SIZE 214 ABI_MAGIC 215 ABI_VERSION 216 ABI_LENGTH
//   217 ABI_RESERVED (also: the parser has not completed the list, or an expander cell is corrupt)
// A refusal stores code and the byte offset of the word being expanded (the command word start for 239) in the session
// and makes it terminal (phase 255); a repeated call returns the same code. Pipelines before it were already returned.
//
// Pipeline selection (unless the host set S_NOSKIP = 1, which emits every pipeline): pipeline p > 0 runs iff the connector after pipeline p-1 allows it given S_LAST_STATUS (&& needs 0,
// || needs nonzero, ; always); a skipped pipeline is never expanded and S_LAST_STATUS is unchanged, so the next
// connector sees the same status (left to right, as a POSIX list).
//
// Expansion per word, one pass over the raw token bytes: backslash removal (unquoted: \x gives x; in "": only \$ \" \\
// \` and backslash-newline are escapes, other backslashes stay), '' and "" removal, backslash-newline removal, and
// $NAME ${NAME} $0..$9 ${0..9} $? $# $@ $*. Field splitting is by the fixed IFS (space, tab, newline) and only for unquoted
// expansions in command words and redirection targets. An unquoted expansion result byte * ? [ is VALUE_GLOB.
// Empty rules: '' and "" and "$X" keep one empty field; an unquoted expansion that is empty or all IFS adds none;
// "$@" with no positionals adds none; "a$@b" with none is ab. Assignment values (NAME=value before the command word) are
// expanded without splitting and without the glob check; $@ and $* there join the positionals with one space. In a
// standalone assignment list (no command word) a later value sees an earlier value of the same name.
// A redirection target must expand to exactly one field (AMBIGUOUS_REDIRECT otherwise). N>&M copies N and M.
//
// Word state lives in the session (EX_* cells); every step is atomic, so any call may be repeated after 101 and 102.

// Record a refusal: code and byte offset into the session, session terminal. Returns the code.
fn fail(w: cells, code: u64, off: u64) -> u64 {
    w[4] = code;
    w[5] = off;
    w[2] = 255;
    return code;
}

// A refusal at the start of the word being expanded.
fn werr(w: cells, code: u64) -> u64 {
    return fail(w, code, w[64 + w[32] * 4 + 1]);
}

// ABI header check (OSH_PLATFORM_ABI.md section 3): first failure wins, nothing is written.
fn abi_check(w: cells) -> u64 {
    if w.len < 2 { return 216; }
    if w[0] != 1330858071 { return 214; }
    if w[1] != 1 { return 215; }
    if w.len < 11456 { return 213; }
    for j in 48 .. 64 {
        if w[j as u64] != 0 { return 217; }
    }
    if w[28] > 1 { return 217; }
    return 0;
}

// 1 when c may be in a NAME (digits only when first is 0).
fn nch(c: u64, first: u64) -> u64 {
    if c >= 65 && c <= 90 { return 1; }
    if c >= 97 && c <= 122 { return 1; }
    if c == 95 { return 1; }
    if first == 0 && c >= 48 && c <= 57 { return 1; }
    return 0;
}

// End (exclusive) of the NAME that starts at p, below e.
fn nend(inp: bytes, p: u64, e: u64) -> u64 {
    let mut i: u64 = p + 1;
    while i < e && nch(inp[i], 0) == 1 bound 4096 {
        i = i + 1;
    }
    return i;
}

// The `$` at p (token ends at e): 1 when it starts a reference (EX_RK, S_VR_A, S_VR_LEN, EX_NEXT set), 0 when it is a
// literal dollar. RK 8 is $@ and 9 is $*; begin_ref turns them into list modes.
fn dollar(inp: bytes, w: cells, p: u64, e: u64) -> u64 {
    if p + 1 >= e { return 0; }
    let c: u64 = inp[p + 1];
    w[10] = 0;
    w[9] = 0;
    if nch(c, 1) == 1 {
        let n: u64 = nend(inp, p + 1, e);
        w[22] = 1;
        w[9] = p + 1;
        w[10] = n - p - 1;
        w[18] = n;
        return 1;
    }
    if c >= 48 && c <= 57 {
        w[22] = 3;
        w[9] = c - 48;
        w[18] = p + 2;
        return 1;
    }
    if c == 63 || c == 35 || c == 64 || c == 42 {
        let mut rk: u64 = 2;
        if c == 35 { rk = 4; }
        if c == 64 { rk = 8; }
        if c == 42 { rk = 9; }
        w[22] = rk;
        w[18] = p + 2;
        return 1;
    }
    if c == 123 && p + 3 < e {
        let d: u64 = inp[p + 2];
        if d >= 48 && d <= 57 {
            if inp[p + 3] != 125 { return 0; }
            w[22] = 3;
            w[9] = d - 48;
            w[18] = p + 4;
            return 1;
        }
        if nch(d, 1) == 1 {
            let n2: u64 = nend(inp, p + 2, e);
            if n2 < e && inp[n2] == 125 {
                w[22] = 1;
                w[9] = p + 2;
                w[10] = n2 - p - 2;
                w[18] = n2 + 1;
                return 1;
            }
        }
    }
    return 0;
}

// First cell of the request block of the current command.
fn cbase(w: cells) -> u64 {
    return 1928 + 8 + w[31] * 164;
}

// Open a field if none is open.
fn fopen_(w: cells) {
    if w[13] == 0 {
        w[13] = 1;
        w[14] = w[42];
    }
}

// Close the open field (if any): argv entry, or the single redirection target.
fn fclose(w: cells) -> u64 {
    if w[13] == 0 { return 0; }
    w[13] = 0;
    let wm: u64 = w[45];
    if wm == 2 { return 0; }
    let off: u64 = w[14];
    let ln: u64 = w[42] - off;
    let cb: u64 = cbase(w);
    if wm == 1 || wm == 4 {
        let n: u64 = w[cb];
        if n >= 32 { return werr(w, 209); }
        if n == 0 { w[44] = w[64 + w[32] * 4 + 1]; }
        w[cb + 4 + n * 2] = off;
        w[cb + 5 + n * 2] = ln;
        w[cb] = n + 1;
        return 0;
    }
    if w[16] != 0 { return werr(w, 243); }
    w[16] = 1;
    let e: u64 = cb + 132 + (w[cb + 2] - 1) * 4;
    w[e + 2] = off;
    w[e + 3] = ln;
    return 0;
