// Append one byte to the open field (opening one if needed).
fn lit(w: cells, c: u64) -> u64 {
    let o: u64 = w[42];
    if o >= 8192 { return werr(w, 210); }
    fopen_(w);
    w[3264 + o] = c;
    w[42] = o + 1;
    return 0;
}

// One byte of an unquoted expansion result: an IFS byte ends the field, * ? [ are refused, anything else is literal.
fn sbyte(w: cells, c: u64) -> u64 {
    if c == 32 || c == 9 || c == 10 { return fclose(w); }
    if c == 42 || c == 63 || c == 91 { return werr(w, 245); }
    return lit(w, c);
