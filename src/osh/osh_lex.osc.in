// osh lexer unit (aien-architecture#158, cut 4a): a bounded, resumable shell tokenizer.
// Entry: lex_run(inp, w). Contract: aien-protocols specs/osh-platform/OSH_PLATFORM_ABI.md (v1 DRAFT);
// design: handoffs/osh-audit/E-parser-design.md section 2. Needs the external slices (OSC-EXT-BYTES).
//
// inp: the accumulated command text (append-only). w: the 11456-cell session workspace. All state is in
// w; the unit stores no pointer. One call lexes at most @LEX_BUDGET@ input bytes, writes a token record
// first and advances the cursor after, and returns one status:
//   0 PHASE_DONE        every buffered byte is lexed and the last byte ended a line (newline at rest)
//   100 NEED_MORE_INPUT the buffer ends inside an incomplete line (open quote, `${`, trailing backslash,
//                       pending operator or word, no final newline); append and call again
//   101 BUDGET_EXHAUSTED  budget spent, call again with no new input
//   201 CAP_LINE (buffer byte @LINE_CAP@ reached)  202 CAP_TOKENS (@TOKEN_CAP@ tokens)
//   213 WORKSPACE_SIZE 214 ABI_MAGIC 215 ABI_VERSION 216 ABI_LENGTH 217 ABI_RESERVED
//   220 NUL_BYTE 221 BACKTICK 222 GLOB 223 TILDE 224 PARAM_OP 225 SPECIAL_PARAM 226 CMDSUB 227 BACKGROUND
//   228 SUBSHELL 229 HEREDOC 230 CASEEND 231 REDIR_OTHER 232 FD_RANGE
//   236 GROUP (a lone `{` or `}` word at command start) 246 BRACE_EXPANSION 247 POSITIONAL_RANGE (${10}, ${00})
//   249 APPEND_ASSIGN (a NAME+= word; also `$_` and `${_}` are refused as 225 SPECIAL_PARAM)
// Line continuation: a backslash-newline pair is removed before the byte after it is classified, in every state
// except single quotes and comments (bash rule). A chunk that ends in a lone `\` waits (status 100, the `\`
// is not consumed) unless the host set S_EOI, when that `\` is a literal byte. Refusal offsets and token spans
// are always in the original input.
// A refusal stores code and byte offset in the session and makes it terminal (phase 255); a repeated call
// returns the same code. ABI header refusals write nothing.
//
// Token record, 4 cells at TOKENS + 4*t:
//   0: kind bits 0-7 | flags bits 8-23 | quoted segments bits 24-31 | line (1-based) bits 32-47
//   1: start offset into inp   2: length in bytes (raw source span)
//   3: WORD: offset+1 of the `=` when the word starts with a NAME= (else 0)
//      redirection operator: source fd (explicit IO number, else 1 for > >> >&, 0 for < <&); 0 otherwise
// Kinds: 1 WORD 2 PIPE 3 OR 4 AND 5 SEMI 6 LT 7 GT 8 APPEND 9 NL 10 DUP_OUT(>&) 11 DUP_IN(<&)
// Flags: 1 has ' 2 has " 4 has backslash escape 8 has $ 16 assignment word 32 has backslash-newline
// An unquoted single digit 0..2 directly before < > >> >& <& is merged into that operator (IO number);
// any other all-digit word directly before one of them is refused FD_RANGE.
//
// Character classes: 0 NUL 1 BLANK 2 NL 3 ' 4 " 5 \ 6 $ 7 ` 8 OPCH(| & ; < > ( )) 9 # 10 { 11 } 12 ALPHA/_
//   13 = 14 GLOB(* ? [) 15 OTHER (bytes >= 0x80 and CR included) 16 DIGIT 17 ~ 18 ~ refused inside NAME=value
// States: 0 START 1 WORD 2 SQ 3 DQ 4 BS_W 5 BS_DQ 6 DOLLAR_W 7 DOLLAR_DQ 8 BRACE_W 9 BRACE_DQ 10 COMMENT
//   11 OP 12 BS_S (backslash at the start of a word)
// step() returns next_state | action << 8 | refusal << 16 | token_flags << 24. Actions: 1 begin word here,
//   2 end word before this byte and re-dispatch it from START, 3 end a one-byte operator and re-dispatch,
//   4 two-byte operator ends here, 6 emit NL, 7 begin operator, 8 begin word at the previous byte.

fn cls(c: u64) -> u64 {
    if c == 0 { return 0; }
    if c == 32 || c == 9 { return 1; }
    if c == 10 { return 2; }
    if c == 39 { return 3; }
    if c == 34 { return 4; }
    if c == 92 { return 5; }
    if c == 36 { return 6; }
    if c == 96 { return 7; }
    if c == 124 || c == 38 || c == 59 || c == 60 || c == 62 || c == 40 || c == 41 { return 8; }
    if c == 35 { return 9; }
    if c == 123 { return 10; }
    if c == 125 { return 11; }
    if c == 61 { return 13; }
    if c == 42 || c == 63 || c == 91 { return 14; }
    if c == 126 { return 17; }
    if c >= 48 && c <= 57 { return 16; }
    if c >= 65 && c <= 90 { return 12; }
    if c >= 97 && c <= 122 { return 12; }
    if c == 95 { return 12; }
    return 15;
}

fn step(st: u64, k: u64, c: u64, p: u64) -> u64 {
    let mut s: u64 = st;
    let mut act: u64 = 0;
    if k == 0 { return s | (220 << 16); }
    if s == 12 {
        if c == 10 { return 0; }
        return 1 | (8 << 8) | (4 << 24);
    }
    if s == 0 {
        if k == 1 { return 0; }
        if k == 2 { return 0 | (6 << 8); }
        if k == 9 { return 10; }
        if k == 5 { return 12; }
        if k == 8 {
            if c == 40 || c == 41 { return 0 | (228 << 16); }
            return 11 | (7 << 8);
        }
        if k == 17 { return 223 << 16; }
        act = 1;
        s = 1;
    }
    if s == 6 || s == 7 {
        let mut ctx: u64 = 1;
        if s == 7 { ctx = 3; }
        if k == 12 || k == 16 { return ctx; }
        if c == 63 || c == 35 || c == 64 || c == 42 { return ctx; }
        if c == 123 { return s + 2; }
        if c == 40 { return s | (226 << 16); }
        if c == 36 || c == 33 || c == 45 { return s | (225 << 16); }
        if s == 6 && (c == 39 || c == 34) { return s | (225 << 16); }
        s = ctx;
    }
    if s == 8 || s == 9 {
        let mut ctx2: u64 = 1;
        if s == 9 { ctx2 = 3; }
        if k == 12 || k == 16 { return s; }
        if k == 11 && p != 123 { return ctx2; }
        return s | (224 << 16);
    }
    if s == 1 {
        if k == 1 || k == 2 || k == 8 { return 0 | (2 << 8); }
        if k == 3 { return 2 | (act << 8) | (1 << 24); }
        if k == 4 { return 3 | (act << 8) | (2 << 24); }
        if k == 5 { return 4 | (act << 8); }
        if k == 6 { return 6 | (act << 8) | (8 << 24); }
        if k == 7 { return 221 << 16; }
        if k == 14 { return 222 << 16; }
        if k == 18 { return 223 << 16; }
        return 1 | (act << 8);
    }
    if s == 2 {
        if k == 3 { return 1; }
        return 2;
    }
    if s == 3 {
        if k == 4 { return 1; }
        if k == 5 { return 5; }
        if k == 6 { return 7 | (8 << 24); }
        if k == 7 { return 221 << 16; }
        return 3;
    }
    if s == 4 {
        if c == 10 { return 1 | (32 << 24); }
        return 1 | (4 << 24);
    }
    if s == 5 {
        if c == 10 { return 3 | (32 << 24); }
        return 3 | (4 << 24);
    }
    if s == 10 {
        if k == 2 { return 0 | (6 << 8); }
        return 10;
    }
    if s == 11 {
        if p == 62 && c == 62 { return 0 | (4 << 8); }
        if p == 124 && c == 124 { return 0 | (4 << 8); }
        if p == 38 && c == 38 { return 0 | (4 << 8); }
        if p == 62 && c == 38 { return 0 | (4 << 8); }
        if p == 60 && c == 38 { return 0 | (4 << 8); }
        if p == 60 && c == 60 { return 229 << 16; }
        if p == 59 && c == 59 { return 230 << 16; }
        if (p == 62 && c == 124) || (p == 60 && c == 62) { return 231 << 16; }
        return 0 | (3 << 8);
    }
    return 217 << 16;
}

// Operator kind from its first byte and the second byte (0 = none); a value >= 200 is a refusal code.
fn opkind(p: u64, c2: u64) -> u64 {
    if p == 124 {
        if c2 == 124 { return 3; }
        return 2;
    }
    if p == 38 {
        if c2 == 38 { return 4; }
        return 227;
    }
    if p == 59 { return 5; }
    if p == 60 {
        if c2 == 38 { return 11; }
        return 6;
    }
    if p == 62 {
        if c2 == 62 { return 8; }
        if c2 == 38 { return 10; }
        return 7;
    }
    return 217;
}

// Record a refusal: code and byte offset into the session, session terminal. Returns the code.
fn fail(w: cells, code: u64, off: u64) -> u64 {
    w[@S_ERR_CODE@] = code;
    w[@S_ERR_OFF@] = off;
    w[@S_PHASE@] = 255;
    return code;
}

// Write token record t = ntok (record first, count after); CAP_TOKENS before writing past capacity.
fn emit_tok(w: cells, hdr: u64, s: u64, n: u64, aux: u64) -> u64 {
    let t: u64 = w[@LX_NTOK@];
    if t >= @TOKEN_CAP@ { return fail(w, 202, s); }
    let b: u64 = @TOKENS@ + t * 4;
    w[b] = hdr;
    w[b + 1] = s;
    w[b + 2] = n;
    w[b + 3] = aux;
    w[@LX_NTOK@] = t + 1;
    return 0;
}

// The single significant byte of the word inp[s..e) after removing backslash-newline pairs, else 0.
fn lone(inp: bytes, s: u64, e: u64) -> u64 {
    let mut i: u64 = s;
    let mut n: u64 = 0;
    let mut v: u64 = 0;
    while i < e && n < 2 bound 4096 {
        if inp[i] == 92 && i + 1 < e && inp[i + 1] == 10 {
            i = i + 2;
        } else {
            n = n + 1;
            v = inp[i];
            i = i + 1;
        }
    }
    if n != 1 { return 0; }
    return v;
}

// A lone `{` or `}` word where a command may start (start of input, or after NL | || && ;) is the reserved
// group syntax (release 1.2): refused GROUP. Elsewhere it is an ordinary word, as in bash.
fn group_check(inp: bytes, w: cells, s: u64, end: u64) -> u64 {
    if (w[@LX_WFLAGS@] & 65503) != 0 || w[@LX_EQPOS@] != 0 { return 0; }
    let t: u64 = w[@LX_NTOK@];
    let mut cs: u64 = 0;
    if t == 0 { cs = 1; }
    if t > 0 {
        let pk: u64 = w[@TOKENS@ + (t - 1) * 4] & 255;
        if pk == 9 || pk == 2 || pk == 3 || pk == 4 || pk == 5 { cs = 1; }
    }
    if cs == 0 { return 0; }
    let v: u64 = lone(inp, s, end);
    if v == 123 || v == 125 { return fail(w, 236, s); }
    return 0;
}

// The word in progress ends before offset `end`.
fn emit_word(inp: bytes, w: cells, end: u64) -> u64 {
    let s: u64 = w[@LX_WS@];
    let gc: u64 = group_check(inp, w, s, end);
    if gc != 0 { return gc; }
    let mut f: u64 = w[@LX_WFLAGS@];
    let eq: u64 = w[@LX_EQPOS@];
    if eq != 0 { f = f | 16; }
    let mut ns: u64 = w[@LX_NSEG@];
    if ns > 255 { ns = 255; }
    let hdr: u64 = 1 | (f << 8) | (ns << 24) | (w[@LX_WLINE@] << 32);
    return emit_tok(w, hdr, s, end - s, eq);
}

fn emit_nl(w: cells, i: u64) -> u64 {
    return emit_tok(w, 9 | ((w[@LX_LINE@] + 1) << 32), i, 1, 0);
}

// IO number: 0 none; 1..3 = the single digit 0..2 word that ends at ws (a backslash-newline pair inside it does
// not count), plus one; 100 = an all-digit unquoted word that ends at ws but is not a digit 0..2 (FD_RANGE).
fn iomerge(inp: bytes, w: cells, ws: u64) -> u64 {
    let t: u64 = w[@LX_NTOK@];
    if t == 0 { return 0; }
    let b: u64 = @TOKENS@ + (t - 1) * 4;
    if (w[b] & 4294959103) != 1 { return 0; }
    if w[b + 1] + w[b + 2] != ws { return 0; }
    if w[@LX_ALLDIG@] != 1 { return 0; }
    let v: u64 = lone(inp, w[b + 1], ws);
    if v == 0 { return 100; }
    let d: u64 = v - 48;
    if d > 2 { return 100; }
    return d + 1;
}

// An operator of `kind` is complete: it starts at LX_WS and its last byte is at oe - 1 (a backslash-newline pair
// may sit between its bytes, so the span is the raw source).
fn emit_op(inp: bytes, w: cells, kind: u64, oe: u64) -> u64 {
    let ws: u64 = w[@LX_WS@];
    if kind >= 200 { return fail(w, kind, ws); }
    let mut aux: u64 = 0;
    if kind == 7 || kind == 8 || kind == 10 { aux = 1; }
    if kind == 6 || kind == 7 || kind == 8 || kind == 10 || kind == 11 {
        let m: u64 = iomerge(inp, w, ws);
        if m == 100 { return fail(w, 232, ws); }
        if m != 0 {
            let b: u64 = @TOKENS@ + (w[@LX_NTOK@] - 1) * 4;
            w[b] = w[b] - 1 + kind;
            w[b + 2] = oe - w[b + 1];
            w[b + 3] = m - 1;
            return 0;
        }
    }
    return emit_tok(w, kind | (w[@LX_WLINE@] << 32), ws, oe - ws, aux);
}

// Per-word bookkeeping after a byte inside a word: valid NAME so far, the `=` of NAME=, all digits.
fn track(w: cells, st: u64, nst: u64, k: u64, i: u64) {
    let ws: u64 = w[@LX_WS@];
    if w[@LX_NAMEOK@] == 1 {
        if st == 4 {
            if k != 2 { w[@LX_NAMEOK@] = 0; }
        } else {
            if st != 1 || k != 5 {
                if k != 12 && !(k == 16 && i > ws) {
                    if k == 13 && i > ws && nst == 1 { w[@LX_EQPOS@] = i + 1; }
                    w[@LX_NAMEOK@] = 0;
                }
            }
        }
    }
    if w[@LX_ALLDIG@] == 1 {
        if k != 16 || nst != 1 { w[@LX_ALLDIG@] = 0; }
    }
}

// Unquoted brace expansion detector. Called for each byte that is a plain (unquoted, unescaped) part of a
// word. bash expands a word with an unquoted `{ ... }` pair that has an unquoted `,` or `..` directly inside;
// that expansion is refused by name (BRACE_EXPANSION). Braces without either stay literal, as in bash. This
// over-refuses a few shapes bash leaves literal (`{a..bb}`); it never lets an expansion through.
fn brace(w: cells, c: u64, i: u64) -> u64 {
    let d: u64 = w[@LX_BRD@];
    let pd: u64 = w[@LX_PDOT@];
    w[@LX_PDOT@] = 0;
    if c == 123 {
        if d >= 62 { return fail(w, 246, i); }
        let bit: u64 = 1 << d;
        w[@LX_BRM@] = w[@LX_BRM@] & ~bit;
        w[@LX_BRD@] = d + 1;
        return 0;
    }
    if d == 0 { return 0; }
    if c == 125 {
        let nd: u64 = d - 1;
        w[@LX_BRD@] = nd;
        let bit: u64 = 1 << nd;
        if (w[@LX_BRM@] & bit) != 0 { return fail(w, 246, i); }
        return 0;
    }
    if c == 44 {
        let bit: u64 = 1 << (d - 1);
        w[@LX_BRM@] = w[@LX_BRM@] | bit;
        return 0;
    }
    if c == 46 {
        if pd == 1 {
            let bit: u64 = 1 << (d - 1);
            w[@LX_BRM@] = w[@LX_BRM@] | bit;
        } else {
            w[@LX_PDOT@] = 1;
        }
    }
    return 0;
}

// Byte k (class) of a ${...} name. The name is NAME or one digit ($0..$9 only): a second digit is
// POSITIONAL_RANGE, a letter after a leading digit is PARAM_OP.
fn bname(w: cells, k: u64, p: u64, i: u64) -> u64 {
    if p == 123 {
        w[@LX_BRN@] = 0;
        if k == 16 { w[@LX_BRN@] = 1; }
        return 0;
    }
    if w[@LX_BRN@] == 1 {
        if k == 16 { return fail(w, 247, i); }
        if k == 12 { return fail(w, 224, i); }
    }
    return 0;
}

// Lex the byte at offset i. Returns 0, a refusal code, or 99 (wait: a final backslash needs the next byte).
// Backslash-newline is removed before the next byte is classified, in every state except single quotes (and
// comments, where a backslash is literal): a `\` that is followed by a newline only sets LX_CONT and changes
// nothing else; the newline then counts the line, flags a word in progress (32) and is otherwise invisible,
// so the previous-byte cells (LX_PREV, LX_PO), the state and the pending operator or `$` all see through it.
fn lex_byte(inp: bytes, w: cells, i: u64) -> u64 {
    let c: u64 = inp[i];
    let st: u64 = w[@LX_STATE@];
    if w[@LX_CONT@] == 1 {
        w[@LX_CONT@] = 0;
        if st == 1 || st == 3 || st == 6 || st == 7 || st == 8 || st == 9 {
            w[@LX_WFLAGS@] = w[@LX_WFLAGS@] | 32;
        }
        w[@LX_LINE@] = w[@LX_LINE@] + 1;
        w[@LX_MID@] = 1;
        return 0;
    }
    let mut k: u64 = cls(c);
    if c == 92 && st != 2 && st != 4 && st != 5 && st != 10 && st != 12 {
        if i + 1 < inp.len {
            if inp[i + 1] == 10 {
                w[@LX_CONT@] = 1;
                return 0;
            }
        } else {
            if w[@S_EOI@] == 0 { return 99; }
            k = 15;
        }
    }
    let p: u64 = w[@LX_PREV@];
    let eq: u64 = w[@LX_EQPOS@];
    if st == 1 && k == 17 && eq != 0 {
        if (p == 61 && eq == w[@LX_PO@] + 1) || p == 58 { k = 18; }
    }
    let usc: u64 = w[@LX_USC@];
    if usc != 0 && c != 0 {
        if (st == 1 || st == 3) {
            if k == 12 || k == 16 { w[@LX_USC@] = 0; } else { return fail(w, 225, usc - 1); }
        }
        if (st == 8 || st == 9) && k == 11 { return fail(w, 225, usc - 1); }
    }
    let mut r: u64 = step(st, k, c, p);
    let mut act: u64 = (r >> 8) & 255;
    let mut err: u64 = (r >> 16) & 255;
    if err != 0 { return fail(w, err, i); }
    let mut rc: u64 = 0;
    if act == 2 {
        rc = emit_word(inp, w, i);
        if rc != 0 { return rc; }
        r = step(0, k, c, p);
    }
    if act == 3 {
        rc = emit_op(inp, w, opkind(p, 0), w[@LX_PO@] + 1);
        if rc != 0 { return rc; }
        r = step(0, k, c, p);
    }
    act = (r >> 8) & 255;
    err = (r >> 16) & 255;
    if err != 0 { return fail(w, err, i); }
    if act == 4 {
        rc = emit_op(inp, w, opkind(p, c), i + 1);
        if rc != 0 { return rc; }
    }
    if act == 6 {
        rc = emit_nl(w, i);
        if rc != 0 { return rc; }
    }
    if act == 7 {
        w[@LX_WS@] = i;
        w[@LX_WLINE@] = w[@LX_LINE@] + 1;
    }
    if act == 1 || act == 8 {
        let mut b: u64 = i;
        let mut nm: u64 = 1;
        if act == 8 {
            b = i - 1;
            nm = 0;
        }
        w[@LX_WS@] = b;
        w[@LX_WLINE@] = w[@LX_LINE@] + 1;
        w[@LX_WFLAGS@] = 0;
        w[@LX_NAMEOK@] = nm;
        w[@LX_EQPOS@] = 0;
        w[@LX_NSEG@] = 0;
        w[@LX_ALLDIG@] = nm;
        w[@LX_BRD@] = 0;
        w[@LX_BRM@] = 0;
        w[@LX_PDOT@] = 0;
        w[@LX_PLUS@] = 0;
        w[@LX_USC@] = 0;
    }
    if (st == 8 || st == 9) && (k == 12 || k == 16) {
        rc = bname(w, k, p, i);
        if rc != 0 { return rc; }
        w[@LX_USC@] = 0;
        if p == 123 && c == 95 { w[@LX_USC@] = i + 1; }
    }
    let nst: u64 = r & 255;
    if (st == 6 || st == 7) && c == 95 { w[@LX_USC@] = i + 1; }
    let pl: u64 = w[@LX_PLUS@];
    w[@LX_PLUS@] = 0;
    if st == 1 && nst == 1 {
        if pl == 1 && k == 13 { return fail(w, 249, i); }
        if c == 43 && w[@LX_NAMEOK@] == 1 && i > w[@LX_WS@] { w[@LX_PLUS@] = 1; }
    }
    let wfl: u64 = (r >> 24) & 255;
    if wfl != 0 {
        w[@LX_WFLAGS@] = w[@LX_WFLAGS@] | wfl;
        if (wfl & 3) != 0 { w[@LX_NSEG@] = w[@LX_NSEG@] + 1; }
    }
    if nst >= 1 && nst <= 9 { track(w, st, nst, k, i); }
    if nst == 1 && (st == 0 || st == 1 || st == 6 || st == 11) {
        rc = brace(w, c, i);
        if rc != 0 { return rc; }
    } else {
        w[@LX_PDOT@] = 0;
    }
    w[@LX_STATE@] = nst;
    w[@LX_MID@] = 1;
    if act == 6 { w[@LX_MID@] = 0; }
    if c == 10 { w[@LX_LINE@] = w[@LX_LINE@] + 1; }
    w[@LX_PREV@] = c;
    w[@LX_PO@] = i;
    return 0;
}

// Lex up to @LEX_BUDGET@ bytes from the cursor. Returns 0, a refusal code, or 99 (wait for the next byte).
fn lex_chunk(inp: bytes, w: cells) -> u64 {
    let mut i: u64 = w[@S_CURSOR@];
    let mut n: u64 = 0;
    let mut rc: u64 = 0;
    while i < inp.len && n < @LEX_BUDGET@ && rc == 0 bound @LEX_BUDGET@ {
        if i >= @LINE_CAP@ {
            rc = fail(w, 201, @LINE_CAP@);
        } else {
            rc = lex_byte(inp, w, i);
            if rc == 0 {
                i = i + 1;
                n = n + 1;
                w[@S_CURSOR@] = i;
            }
        }
    }
    return rc;
}

// ABI header check (OSH_PLATFORM_ABI.md section 3): first failure wins, nothing is written.
fn abi_check(w: cells) -> u64 {
    if w.len < 2 { return 216; }
    if w[@S_MAGIC@] != @ABI_MAGIC@ { return 214; }
    if w[@S_VERSION@] != @ABI_VERSION@ { return 215; }
    if w.len < @WS_CELLS@ { return 213; }
    for j in @S_RESERVED@ .. 64 {
        if w[j as u64] != 0 { return 217; }
    }
    return 0;
}

fn lex_run(inp: bytes, w: cells) -> u64 {
    let ac: u64 = abi_check(w);
    if ac != 0 { return ac; }
    if w[@S_PHASE@] == 255 { return w[@S_ERR_CODE@]; }
    if w[@S_CURSOR@] > inp.len { return 216; }
    let rc: u64 = lex_chunk(inp, w);
    if rc == 99 { return 100; }
    if rc != 0 { return rc; }
    if w[@S_CURSOR@] < inp.len { return 101; }
    if w[@LX_MID@] == 0 { return 0; }
    return 100;
}
