# osh workspace layout: the one list every accessor is generated from (osh_gen.sh).
# Format: NAME VALUE   (decimal; text after '#' is a comment). Cells are u64.
# Region numbers are fixed by OSH_PLATFORM_ABI.md section 6.1 (aien-protocols PR #16, v1 DRAFT);
# session cells 0..11 by section 6.2; 12..47 are core-internal and are assigned here.

# --- ABI constants (section 3, 5, 6) ---
ABI_MAGIC 1330858071        # 0x4F534857 "OSHW"
ABI_VERSION 1
WS_CELLS 11456              # exact workspace size in cells
LINE_CAP 4096               # CAP_LINE: bytes of buffered input
TOKEN_CAP 128               # CAP_TOKENS
LEX_BUDGET 1024             # input bytes per lex_run call

# --- regions (section 6.1) ---
SESSION 0
TOKENS 64
CMDS 576
PIPES 832
STAGING 896
REQUEST 1928
OUT 3264

# --- session cells (section 6.2) ---
S_MAGIC 0
S_VERSION 1
S_PHASE 2                   # 0 active, 255 terminal error
S_LAST_STATUS 3             # adapter-owned ($?); the lexer never touches it
S_ERR_CODE 4
S_ERR_OFF 5
S_CURSOR 6                  # next input byte to lex
S_WS_CELLS 7
S_RESERVED 48               # 48..63 must be zero in v1

# --- lexer-internal session cells (12..47) ---
LX_STATE 12                 # state machine state (osh_lex.osc.in)
LX_WS 13                    # start offset of the word or operator in progress
LX_WFLAGS 14                # token flags gathered for the word in progress
LX_NAMEOK 15                # word so far is a valid NAME
LX_EQPOS 16                 # offset+1 of the '=' of a NAME= word, else 0
LX_NTOK 17                  # tokens written
LX_LINE 18                  # newlines consumed (line number minus 1)
LX_WLINE 19                 # line number (1-based) where the word started
LX_NSEG 20                  # quoted segments in the word
LX_ALLDIG 21                # word so far is all digits
LX_MID 22                   # 1 while the last byte did not complete a line
LX_BRD 23                   # open unquoted `{` count in the word (brace expansion detector)
LX_BRM 24                   # bit d set: the open brace at depth d has an unquoted `,` or `..` directly inside
LX_PDOT 25                  # the last byte was an unquoted plain `.` in the word
LX_BRN 26                   # ${...} name: 0 none/alpha start, 1 digits so far (one digit)
LX_DONE 27                  # 1 when the last lex_run returned PHASE_DONE (the parser requires it)
S_EOI 28                    # end of input: written by the host (0 or 1); 1 = no more bytes will be appended; a final `\` is then a literal
LX_CONT 29                  # 1 after a `\` that starts a backslash-newline pair; the next byte (the newline) is swallowed
LX_PREV 30                  # the last significant byte (a swallowed `\<nl>` pair does not count)
LX_PO 31                    # offset of LX_PREV
LX_PLUS 32                  # 1 when the last significant byte was a `+` right after a valid NAME (append-assignment detector)
LX_USC 33                   # offset+1 of a `_` that is the whole name after `$` or `${` (the `$_` special parameter), else 0

# --- parser-internal session cells (osh_parse.osc.in) ---
PX_STATE 34                 # 0 FRESH 1 AFTER_OP 2 IN_CMD 3 NEED_TARGET 4 DONE
PX_TOK 35                   # next token index to parse
PX_NCMD 36                  # command entries written
PX_NPIPE 37                 # pipeline entries written
PX_PCMDS 38                 # commands in the open pipeline
PX_ANYW 39                  # 1 once the current command has a non-assignment word
PX_RKIND 40                 # token kind of the redirection operator awaiting its target

# --- parser capacities (E-parser-design.md section 5, ABI 5.3) ---
CAP_CMDS 32
CAP_PIPES 16
CAP_PIPE_LEN 8
CAP_WORDS 32
CAP_ASSIGNS 16
CAP_REDIRS 8
PARSE_BUDGET 64             # tokens per parse_run call

# --- variable request cells (ABI section 6.2 cells 8..11) ---
S_VR_KIND 8                 # 1 NAME, 2 $?, 3 positional, 4 $#, 5 positional list (npos only)
S_VR_A 9                    # NAME: offset in inp; positional: k
S_VR_LEN 10                 # NAME: length
S_VR_SEQ 11                 # counts requests

# --- expander capacities and constants (E-parser-design.md section 5, ABI 5.3, 7.1) ---
CAP_FIELDS 32               # argv entries per command after splitting
CAP_OUT 8192                # expanded bytes per pipeline
CAP_VALUE 1024              # one variable value
CAP_VARREQ 64               # variable requests per pipeline
EXP_BUDGET 1024             # expander steps (one raw byte or one value byte each) per call
REC_MAGIC 1330791761        # 0x4F524551 "OREQ"
REQ_CMD_CELLS 164

# --- expander cells (osh_expand.osc.in). 41..47 are fresh; 12..16, 18..26 and 29..33 (the lexer's continuation and
# --- append-assignment cells) are lexer cells that are dead
# --- once the parser has completed the list (the session is single use after that), so expand_run zeroes and reuses them.
EX_INIT 41                  # 1 after the first expand_run call zeroed the overlay cells
EX_ST 29                    # 0 pick next pipeline, 1 expanding, 2 PIPELINE_READY returned, 3 list complete
EX_PIPE 30                  # pipeline index being expanded
EX_CMD 31                   # command index inside the pipeline
EX_TOK 32                   # token cursor (the word token while a word is open)
EX_NVREQ 33                 # variable requests in this pipeline
EX_OUT 42                   # OUT bytes used
EX_ANYW 43                  # a non-assignment word was seen in this command
EX_A0 44                    # input offset of the word that produced argv[0]
EX_WM 45                    # word mode: 0 none, 1 argv, 2 assignment value, 3 redirection target
EX_PH 46                    # 0 raw scan, 1 copying a value, 2 waiting for the host's answer
EX_POS 47                   # raw cursor in inp
EX_Q 12                     # 0 unquoted, 1 inside '', 2 inside ""
EX_FOPEN 13                 # a field is open
EX_FSTART 14                # OUT offset where the open field began
EX_DQF 15                   # inside "": bit 0 saw $@, bit 1 saw anything else
EX_WNF 16                   # fields closed by the redirection target word
EX_NEXT 18                  # raw cursor after the reference being resolved
EX_VCUR 19                  # absolute cell of the next value byte
EX_VEND 20                  # absolute cell after the last value byte
EX_VM 21                    # 1 split the value at IFS bytes (unquoted), 0 copy it
EX_RK 22                    # reference: 1 NAME 2 $? 3 positional 4 $# ; lists 5 split 6 joined 7 one field each
EX_K 23                     # list: positional being copied
EX_NPOS 24                  # list: positional count
S_NOSKIP 25                 # host-written before the first expand_run: 1 = emit every pipeline (no connector skipping; conformance vectors)
