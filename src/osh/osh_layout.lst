# osh workspace layout: the one list every accessor is generated from (osh_gen.sh).
# Format: NAME VALUE   (decimal; text after '#' is a comment). Cells are u64.
# Region numbers are fixed by OSH_PLATFORM_ABI.md section 6.1 (aien-protocols PR #16, v1 DRAFT);
# session cells 0..11 by section 6.2; 12..47 are core-internal and are assigned here.

# --- ABI constants (section 3, 5, 6) ---
ABI_MAGIC 1330858071        # 0x4F534857 "OSHW"
ABI_VERSION 1
WS_CELLS 11456              # exact workspace size in cells
LINE_CAP 4096               # CAP_LINE: bytes of buffered input
TOKEN_CAP 128               # CAP_TOKENS
LEX_BUDGET 1024             # input bytes per lex_run call

# --- regions (section 6.1) ---
SESSION 0
TOKENS 64
CMDS 576
PIPES 832
STAGING 896
REQUEST 1928
OUT 3264

# --- session cells (section 6.2) ---
S_MAGIC 0
S_VERSION 1
S_PHASE 2                   # 0 active, 255 terminal error
S_LAST_STATUS 3             # adapter-owned ($?); the lexer never touches it
S_ERR_CODE 4
S_ERR_OFF 5
S_CURSOR 6                  # next input byte to lex
S_WS_CELLS 7
S_RESERVED 48               # 48..63 must be zero in v1

# --- lexer-internal session cells (12..47) ---
LX_STATE 12                 # state machine state (osh_lex.osc.in)
LX_WS 13                    # start offset of the word or operator in progress
LX_WFLAGS 14                # token flags gathered for the word in progress
LX_NAMEOK 15                # word so far is a valid NAME
LX_EQPOS 16                 # offset+1 of the '=' of a NAME= word, else 0
LX_NTOK 17                  # tokens written
LX_LINE 18                  # newlines consumed (line number minus 1)
LX_WLINE 19                 # line number (1-based) where the word started
LX_NSEG 20                  # quoted segments in the word
LX_ALLDIG 21                # word so far is all digits
LX_MID 22                   # 1 while the last byte did not complete a line
LX_BRD 23                   # open unquoted `{` count in the word (brace expansion detector)
LX_BRM 24                   # bit d set: the open brace at depth d has an unquoted `,` or `..` directly inside
LX_PDOT 25                  # the last byte was an unquoted plain `.` in the word
LX_BRN 26                   # ${...} name: 0 none/alpha start, 1 digits so far (one digit)
S_EOI 27                    # host-set: 1 = the input has ended (explicit end-of-input flush); a trailing `\` is then a literal
LX_CONT 28                  # 1 after a `\` that starts a backslash-newline pair; the next byte (the newline) is swallowed
LX_PREV 29                  # the last significant byte (a swallowed `\<nl>` pair does not count)
LX_PO 30                    # offset of LX_PREV
LX_PLUS 31                  # 1 when the last significant byte was a `+` right after a valid NAME (append-assignment detector)
LX_USC 32                   # offset+1 of a `_` that is the whole name after `$` or `${` (the `$_` special parameter), else 0
